---
// The way in for a newcomer, right under the first screen (6.4.0 site, Q4): fly a whole flight on the ground
// before taking the app into the air. The hatched ground is the dry run's own band in the app.
import { shot } from '../lib/shots';
interface Props {
  dry: { band: string; title: string; text: string; link: { label: string; href: string }; shot: string; alt: string };
  device?: 'iphone' | 'ipad';
  id?: string;
}
const { dry, device = 'iphone', id = 'dry-run' } = Astro.props;
const s = shot(dry.shot);
const src = device === 'ipad' ? s.ipad : s.iphone;
---
<section {id} class="dry reveal">
  <div class="container">
    <div class="dry-inner">
      <div class="dry-copy">
        <span class="dry-band">{dry.band}</span>
        <h2 class="dry-title">{dry.title}</h2>
        <p class="dry-text">{dry.text}</p>
        <a class="dry-link" href={dry.link.href}>{dry.link.label} <span aria-hidden="true">→</span></a>
      </div>
      <div class:list={['dry-dev', `dry-dev--${device}`]}>
        <div class="screen"><img src={src} alt={dry.alt} width={device === 'ipad' ? 1112 : 800} height={device === 'ipad' ? 1600 : 1739} loading="lazy" decoding="async" /></div>
      </div>
    </div>
  </div>
</section>

<style>
  .dry { padding: 24px 0 40px; scroll-margin-top: 72px; }
  .dry-inner { display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: center; padding: 34px 40px; border-radius: 22px; border: 1px solid var(--line-2);
    background: repeating-linear-gradient(135deg, var(--panel-2) 0 14px, var(--bg-band) 14px 28px); }
  .dry-band { display: inline-block; font-family: var(--mono); font-size: 12px; letter-spacing: .12em; background: #000; color: #fff; padding: 4px 9px; border-radius: 5px; }
  .dry-title { font-size: clamp(24px, 3.2vw, 32px); margin: 16px 0 12px; max-width: 24ch; }
  .dry-text { color: var(--muted); font-size: 16.5px; line-height: 1.65; max-width: 54ch; margin: 0 0 16px; }
  .dry-link { color: var(--cyan); font-weight: 700; border-bottom: 1px solid color-mix(in srgb, var(--cyan) 40%, transparent); padding-bottom: 1px; }
  .dry-link:hover { border-color: var(--cyan); }
  .dry-dev { background: #0A0A0D; border-radius: 30px; padding: 6px; box-shadow: 0 24px 50px var(--shadow), inset 0 0 0 1px rgba(255, 255, 255, .08); }
  .dry-dev--iphone { width: 190px; }
  .dry-dev--ipad { width: 300px; border-radius: 22px; padding: 8px; }
  .screen { overflow: hidden; border-radius: 25px; line-height: 0; background: #0C0C10; }
  .dry-dev--ipad .screen { border-radius: 15px; }
  .screen img { width: 100%; height: auto; display: block; }
  @media (max-width: 720px) {
    .dry-inner { grid-template-columns: 1fr; padding: 26px 22px; }
    .dry-dev { justify-self: center; }
  }
</style>
