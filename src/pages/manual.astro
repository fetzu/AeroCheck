---
import Base from '../layouts/Base.astro';
import PageStub from '../components/PageStub.astro';
import { loadSite } from '../lib/site';
const site = loadSite('en');
---
<Base site={site} lang="en" title={site.nav.manual}>
  <PageStub label={site.nav.manual} heading="User manual — coming soon"
    body="The in-depth user manual is being ported to the new site. In the meantime, the GitHub releases cover what's new."
    home="/" homeLabel="Back home" />
</Base>
