---
import type { SiteData } from '../lib/site';
import { langBase } from '../lib/langs';
import { appVersion } from '../lib/version';
import Icon from './Icon.astro';
interface Props { site: SiteData; }
const { site } = Astro.props;
const f = site.footer;
// Live version from the latest GitHub release (resolved at build time).
const version = await appVersion();
const base = langBase(site.lang);
const changelogHref = `${base}/changelog`;
const privacyHref = `${base}/privacy`;
const mapHref = `${base}/map`;
const termsHref = `${base}/terms`;
const supportHref = `${base}/support`;
---
<footer class="site-footer">
  <div class="container footer-safety"><p>{f.safety}</p></div>
  <div class="container footer-inner">
    <span>{f.made_by} <a href={f.author_url} class="footer-link" target="_blank" rel="noopener">{f.author}</a> {f.with} <Icon name="heart" size={12} class="heart" /> {f.in} {f.city}</span>
    <span class="footer-meta"><a href={changelogHref} class="footer-link">v{version}</a> · <a href={supportHref} class="footer-link">{f.support}</a> · <a href={termsHref} class="footer-link">{f.terms}</a> · <a href={privacyHref} class="footer-link">{f.privacy}</a> · <a href={mapHref} class="footer-link">{f.map}</a> · <a href={f.license_url} class="footer-link" target="_blank" rel="noopener">{f.license}</a></span>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); background: var(--bg-band); }
  .footer-safety p { margin: 0; padding: 16px 0 0; font-size: 12.5px; color: var(--muted); }
  .footer-inner { display: flex; align-items: center; justify-content: space-between; height: 56px; font-size: 12px; color: var(--dim); }
  .footer-inner :global(.heart) { color: var(--gold); vertical-align: -2px; }
  .footer-meta { font-variant-numeric: tabular-nums; }
  .footer-link { color: inherit; text-decoration: none; border-bottom: 1px solid var(--line); transition: color .2s ease, border-color .2s ease; }
  .footer-link:hover { color: var(--gold); border-color: var(--gold); }
</style>
