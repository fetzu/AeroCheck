    "nav.offlineDesc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App ist im Offline-Modus. Die ICAO-Karte und die Segelflugkarte sind beide auf diesem Gerät gespeichert, und die Karte wechselt beim Zoomen zwischen ihnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is in offline mode. The ICAO Chart and the Segelflugkarte are both saved on this device, and the map switches between them as you zoom."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application est en mode hors ligne. La carte OACI et la Segelflugkarte sont toutes deux enregistrées sur cet appareil, et la carte passe de l'une à l'autre selon le zoom."
          }
        }
      }
    },
