---
// The long tail, written once, at the foot of the page: what the old "Everything else" grid and the pills said.
interface Props { label: string; items: string[]; }
const { label, items } = Astro.props;
---
<section class="also reveal">
  <div class="container">
    <p><b>{label}</b> {items.join(' · ')}</p>
  </div>
</section>

<style>
  .also { padding: 8px 0 56px; }
  .also p { margin: 0; color: var(--muted); font-size: 15px; line-height: 1.8; padding-top: 22px; border-top: 1px solid var(--line); }
  .also b { color: var(--text); margin-right: 6px; }
</style>
