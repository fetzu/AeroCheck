    "icaoNames.explainer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Route bezeichnet diese Flugplätze mit Ortsnamen. AéroCheck kann sie durch ihre ICAO-Codes ersetzen, mit denen es PPR, Landetaxen, Treibstoff und Frequenzen nachschlägt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This route uses place names for these aerodromes. AéroCheck can replace them with their ICAO codes, which it uses to look up PPR, landing fees, fuel and frequencies."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette route désigne ces aérodromes par un nom de lieu. AéroCheck peut les remplacer par leurs codes OACI, qui servent à rechercher PPR, taxes d'atterrissage, carburant et fréquences."
          }
        }
      }
    },
    "icaoNames.footer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Ortsname bleibt in den Bemerkungen seines Wegpunkts erhalten. Sie können einen Wegpunkt jederzeit im Routeneditor umbenennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each place name is kept in its waypoint's remarks. You can rename a waypoint at any time in the route editor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque nom de lieu est conservé dans les remarques de son point. Vous pouvez renommer un point à tout moment dans l'éditeur de route."
          }
        }
      }
    },
