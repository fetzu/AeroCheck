---
// The App Store badge, the page's main button (6.4.0 site, Q2). Apple's own artwork, unaltered, in the page's
// language (public/assets/badges, from Apple's marketing resources): the black badge, which Apple prefers and whose
// grey edge also holds on a dark page. At 48 px high, above Apple's 40 px minimum, with a quarter of its height
// clear around it. Apple asks for one badge per layout: a page's other calls to download are plain buttons
// ("Download", never "App Store" alone, which reads as the site's own store). The link comes from APP_STORE_URL
// (src/lib/site.ts).
import type { Lang } from '../lib/site';
import { appStoreHref } from '../lib/site';
interface Props { store: { alt: string; cta?: string }; lang: Lang; }
const { store, lang } = Astro.props;
// The artwork's own proportions (viewBox), at 48 px high.
const BADGES: Record<Lang, { src: string; width: number }> = {
  en: { src: '/assets/badges/app-store-badge-en.svg', width: 144 },
  fr: { src: '/assets/badges/app-store-badge-fr.svg', width: 152 },
};
const badge = BADGES[lang];
---
<a class="store-badge" href={appStoreHref(lang)}>
  <img src={badge.src} alt={store.alt} width={badge.width} height="48" />
</a>

<style>
  .store-badge { display: inline-flex; margin: -12px; padding: 12px; line-height: 0; border-radius: 20px; }
  .store-badge img { display: block; height: 48px; width: auto; }
  .store-badge:focus-visible { outline: 2px solid var(--cyan-fill); outline-offset: -6px; }
</style>
