    "landedCard.explanation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit «Ja» wird sie als nach der Landung bestätigt erfasst. Mit «Nicht sicher» kommt sie ins Debriefing. In beiden Fällen folgt die Kontrolle nach der Landung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes records it as confirmed after landing. Not sure adds it to the debrief. Either way the after landing check comes next."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oui l'enregistre comme confirmée après l'atterrissage. Pas sûr l'ajoute au débriefing. Dans les deux cas, la vérification après l'atterrissage suit."
          }
        }
      }
    },
