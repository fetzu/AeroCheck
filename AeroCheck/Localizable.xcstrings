    "eet.cruiseRow": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reisegeschwindigkeit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cruise speed"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitesse de croisière"
          }
        }
      }
    },
    "eet.cruiseRowFooter": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die angezeigte Fluggeschwindigkeit bei Ihrer Reiseflugleistung. AéroCheck rechnet sie auf der Höhe jeder Teilstrecke in die wahre Eigengeschwindigkeit um, um deren Zeit zu berechnen. Ein von Ihnen eingegebener Wert hat Vorrang. Sonst verwendet AéroCheck die aus Ihren Flügen mit diesem Flugzeug gelernte Geschwindigkeit (ab 5 Flügen), dann die Daten des Flugzeugs, dann 100 kt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The indicated airspeed at your cruise power. AéroCheck converts it to a true airspeed at each leg's altitude to time the leg. A figure you enter is used first. Otherwise AéroCheck uses the speed learned from your flights in this aircraft (from 5 flights), then the aircraft's data, then 100 kt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vitesse indiquée à votre puissance de croisière. AéroCheck la convertit en vitesse propre à l'altitude de chaque branche pour en calculer le temps. Une valeur que vous saisissez est utilisée en priorité. Sinon, AéroCheck utilise la vitesse apprise de vos vols sur cet avion (dès 5 vols), puis les données de l'avion, puis 100 kt."
          }
        }
      }
    },
    "eet.sourceManual": {
