    "aircraftRequest.contactHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone who can speak for the club about its documents (the president, the chief flying instructor, the technical manager). We send them a link to confirm or refuse, nothing else."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une personne qui peut parler au nom du club au sujet de ses documents (le président, le chef-instructeur, le responsable technique). Nous lui envoyons un lien pour confirmer ou refuser, rien d’autre."
          }
        }
      }
    },
    "aircraftRequest.contactUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I don’t know it: I’ll add it later from the request’s page"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
