    "onboarding.briefings.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dynamic departure and approach briefings with wind data. Automatic flight event detection and GPS track export."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Briefings de départ et d'approche dynamiques avec données de vent. Détection automatique des événements de vol et export de trace GPS."
          }
        }
      }
    },
    "onboarding.briefings.title" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Briefings & Flight Log"
