        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque activé, la carte OACI (1:500 000) reste à tous les niveaux de zoom. Lorsque désactivé, bascule automatiquement vers la Segelflugkarte (1:300 000) lors du zoom."
          }
        }
      }
    },
