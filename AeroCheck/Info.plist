<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- OpenAIP API key, injected at build time from OPENAIP_API_KEY (Config.xcconfig / untracked Secrets.xcconfig). Read via OpenAIPConfig.apiKey. Empty when unconfigured. -->
	<key>OpenAIPAPIKey</key>
	<string>$(OPENAIP_API_KEY)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>GPX File</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.topografix.gpx</string>
			</array>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.aerocheck.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>aerocheck</string>
			</array>
		</dict>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
	</dict>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>AéroCheck needs access to save flight log images to your photo library.</string>
	<!-- WiFiAware companion service. TWO hard requirements, each an UNCATCHABLE trap in WiFiAwareServicesPrivate if wrong:
	     (1) the name MUST use the ._udp transport label (a ._tcp name fails RFC6335/6763 validation);
	     (2) the Publishable/Subscribable values MUST be DICTIONARIES (empty is fine), per Apple's "Adopting Wi-Fi Aware" —
	         a Bool (<true/>) traps with "'Publishable' key ... is malformed (not a dictionary)" on Pair New Device (iOS/iPadOS 26).
	     Keep the name in sync with companionWiFiAwareServiceName; CompanionServiceContractTests locks both rules. -->
	<key>WiFiAwareServices</key>
	<dict>
		<key>_aerocheck._udp</key>
		<dict>
			<key>Publishable</key>
			<dict/>
			<key>Subscribable</key>
			<dict/>
		</dict>
	</dict>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>remote-notification</string>
	</array>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSUbiquitousContainerName</key>
	<string>AéroCheck</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchIcon</string>
	</dict>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.xml</string>
			</array>
			<key>UTTypeDescription</key>
			<string>GPS Exchange Format</string>
			<key>UTTypeIdentifier</key>
			<string>com.topografix.gpx</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>gpx</string>
				</array>
				<key>public.mime-type</key>
				<string>application/gpx+xml</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
