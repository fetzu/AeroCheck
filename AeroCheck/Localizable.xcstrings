    "planFlight.legsExplainer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Etappe ist ein eigener Flug: Route (direkt, bis Sie sie zeichnen), Nav-Log, ATC-Flugplan und Flugbuchzeile. Wetter, NOTAM und DABS werden einmal für die Reise vorbereitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each leg is its own flight: route (direct until you draw it), nav log, ATC flight plan and logbook line. Weather, NOTAM and DABS are prepared once for the trip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque étape est un vol à part entière : route (directe tant que vous ne la tracez pas), log de navigation, plan de vol ATC et ligne de carnet de vol. Météo, NOTAM et DABS se préparent une seule fois pour le voyage."
          }
        }
      }
    },
