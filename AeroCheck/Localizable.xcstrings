    "dryRunCoach.storyRowSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan a flight, fly it, close it out and look at it in your logbook, with a guide at each step. About 15 minutes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifiez un vol, faites-le, clôturez-le et retrouvez-le dans votre carnet, avec un guide à chaque étape. Environ 15 minutes."
          }
        }
      }
    },
    "dryRunCoach.todayBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan a flight, fly it with the WT9, close it out and look at it in your logbook, with a guide at each step. It takes about 15 minutes, and none of it is kept."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifiez un vol, faites-le avec le WT9, clôturez-le et retrouvez-le dans votre carnet, avec un guide à chaque étape. Cela prend environ 15 minutes, et rien n'en est gardé."
          }
        }
      }
    },
