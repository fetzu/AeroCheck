// Secrets.example.xcconfig — template for local build secrets (TRACKED).
//
// Copy this file to Secrets.xcconfig (same directory) and fill in real values.
// Secrets.xcconfig is gitignored and MUST NOT be committed.
//
//     cp Secrets.example.xcconfig Secrets.xcconfig
//
// OpenAIP API key — register / manage keys at https://www.openaip.net/
// (account → API keys). Used for the worldwide airspace tile overlay and the
// nearby-CTR REST fallback. A client-embedded key is inherently extractable, so
// keep it OUT of tracked source and rotate it if it ever leaks.
OPENAIP_API_KEY = your_openaip_api_key_here

// Weather-proxy client secret — must match one entry in the worker's
// WEATHER_CLIENT_SECRETS list (`wrangler secret put WEATHER_CLIENT_SECRETS`
// in AeroCheck-server, comma-separated to allow rotation).
//
// This is a HURDLE, not a credential: it stops someone reading the public repo
// from pointing their own app at wx.aerocheck.app, and stops nobody who is
// willing to run `strings` on the IPA. Nothing behind it is worth protecting —
// it fronts free public weather data. Rotate by adding a new value to the
// worker's list, shipping an app update, then retiring the old one.
WEATHER_CLIENT_SECRET = your_weather_client_secret_here
