---
// A row of the landing: the chapter, a blunt title, a short paragraph, at most three plain facts (never chips:
// the 6.4.0 site dropped them, they repeated the text and looked like buttons), an optional calm note, and the
// iPad with the iPhone in front of it.
import type { FlagshipItem, Lang } from '../lib/site';
import { shot } from '../lib/shots';
import DevicePair from './DevicePair.astro';
// `where`: the link to the Countries page, on a row whose features depend on the country (`where: true` in the copy).
interface Props { item: FlagshipItem; index: number; labels: { ipad: string; iphone: string }; where?: { label: string; href: string }; lang?: Lang; }
const { item, index, labels, where, lang } = Astro.props;
const s = shot(item.shot, lang);
const phone = item.iphone_shot ? shot(item.iphone_shot, lang) : s;
const reverse = index % 2 === 1;
---
<div id={item.anchor} class:list={['feature-row', 'reveal', { 'feature-row--reverse': reverse, 'feature-row--fly': item.fly }]}>
  <div class="feature-copy">
    <p class="step">{item.step}</p>
    <h3 class="feature-title">{item.title}</h3>
    <p class="feature-desc">{item.description}</p>
    {item.facts && item.facts.length > 0 && (
      <ul class="facts">{item.facts.slice(0, 3).map((f) => <li>{f}</li>)}</ul>
    )}
    {item.note && <p class="note">{item.note}</p>}
    {item.where && where && <p class="where"><a href={where.href}>{where.label} <span aria-hidden="true">→</span></a></p>}
  </div>
  <div class="feature-media">
    <DevicePair ipad={[s.ipad]} iphone={[phone.iphone]} alts={[item.title]} labels={labels} />
  </div>
</div>

<style>
  .feature-row { scroll-margin-top: 84px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; padding: 44px 0; border-bottom: 1px solid var(--line); }
  .feature-row--reverse .feature-copy { order: 2; }
  .step { font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--gold); margin: 0 0 10px; }
  .feature-row--fly .step { color: var(--cyan); }
  .feature-title { font-size: 26px; margin-bottom: 12px; }
  .feature-desc { color: var(--muted); font-size: 16px; line-height: 1.7; margin: 0 0 16px; max-width: 46ch; }
  .facts { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; font-size: 15px; color: var(--text); }
  .facts li { display: flex; gap: 10px; align-items: baseline; }
  .facts li::before { content: ""; flex: none; width: 6px; height: 6px; border-radius: 50%; background: var(--gold-fill); transform: translateY(-2px); }
  .feature-row--fly .facts li::before { background: var(--cyan-fill); }
  .note { margin: 18px 0 0; padding-left: 12px; border-left: 3px solid var(--gold-fill); font-size: 14px; line-height: 1.55; color: var(--muted); max-width: 46ch; }
  .where { margin: 14px 0 0; font-family: var(--mono); font-size: 11.5px; letter-spacing: .08em; text-transform: uppercase; }
  .where a { color: var(--gold); }
  .feature-row--fly .where a { color: var(--cyan); }
  .feature-media { max-width: 460px; width: 100%; margin: 0 auto; }
  @media (max-width: 820px) {
    .feature-row { grid-template-columns: 1fr; gap: 24px; }
    .feature-row--reverse .feature-copy { order: 0; }
  }
</style>
