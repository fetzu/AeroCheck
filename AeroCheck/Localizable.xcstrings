    "" : {

    },
    "-" : {
      "comment" : "A separator between the runway identifier and its description.",
      "isCommentAutoGenerated" : true
    },
    "—" : {
      "comment" : "A placeholder for the departure/arrival time.",
      "isCommentAutoGenerated" : true
    },
    "..." : {
      "comment" : "A placeholder text indicating that an action is in progress.",
      "isCommentAutoGenerated" : true
    },
    "·" : {
      "comment" : "A distance to the next waypoint.",
      "isCommentAutoGenerated" : true
    },
    "· %@" : {
      "comment" : "A dot separator followed by a detail text in the flight plan strip card",
      "isCommentAutoGenerated" : true
    },
    "···" : {
      "comment" : "An ellipsis symbol used to separate multiple waypoints in a route strip.",
      "isCommentAutoGenerated" : true
    },
    "[" : {

    },
    "]" : {
      "comment" : "A closing bracket.",
      "isCommentAutoGenerated" : true
    },
    "/ %@" : {
      "comment" : "A label showing the elapsed time of a navigation leg, alongside the planned time and a delta showing how far ahead or behind the leg is.",
      "isCommentAutoGenerated" : true
    },
    "%@ %@" : {
      "comment" : "A label that combines the value and label of a quick stat.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@, %@" : {
      "comment" : "A label that describes the action of the button.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@"
          }
        }
      }
    },
    "%@, %@, %@" : {
      "comment" : "A label that reads \"Last Flight\" followed by the flight route, followed by the flight duration.",
