---
// /confirm and /fr/confirm: the club's page, opened with the link the worker e-mails to the club's
// contact (#t=<club token>). What was sent, what confirming means, and the answer (confirm or refuse,
// with a name and a role). Filled by src/scripts/requests/confirm.ts.
import type { Lang } from '../../lib/site';
import { REQUESTS_COPY, toJsonScript } from '../../lib/requests-copy';
import RequestStyles from './RequestStyles.astro';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const copy = REQUESTS_COPY[lang];
const t = copy.confirm;
const otherLangHref = lang === 'fr' ? '/confirm' : '/fr/confirm';
const noscript = lang === 'fr'
  ? 'Cette page a besoin de JavaScript pour afficher la demande.'
  : 'This page needs JavaScript to show the request.';
---
<RequestStyles />
<section class="rq container" data-rq-confirm>
  <p class="eyebrow">{t.eyebrow}</p>
  <h1 class="rq-title">{t.title}</h1>
  <div data-rq-view>
    <p class="rq-loading" role="status"><span class="rq-spinner" aria-hidden="true"></span>{t.loading}</p>
  </div>
  <noscript><div class="rq-alert rq-alert--error"><p>{noscript}</p></div></noscript>
  <p class="rq-aside rq-aside--foot">{t.moreLead} <a href={copy.common.clubsHref}>{t.moreLink}</a> · <a href={otherLangHref} lang={lang === 'fr' ? 'en' : 'fr'} data-rq-lang>{copy.common.otherLang}</a></p>
  <script type="application/json" id="rq-copy" set:html={toJsonScript(copy)}></script>
</section>

<script>import '../../scripts/requests/confirm.ts';</script>
