      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die auf diesem Flug bereits aufgezeichneten Überflugzeiten werden gelöscht. Beim erneuten Aktivieren beginnt die Route wieder beim ersten Wegpunkt."
          }
        },
        "en": {
