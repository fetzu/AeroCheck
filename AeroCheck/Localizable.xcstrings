      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next, the flight itself: START FLIGHT, the Cockpit, the checks, a go-around and a full stop."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
