    "aircraftRequest.problem.privacyRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm that you have read how AéroCheck keeps and uses what you send."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez que vous avez lu comment AéroCheck conserve et utilise ce que vous envoyez."
          }
        }
      }
    },
    "aircraftRequest.error.network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request service isn’t answering. Check your connection and try again; if it still fails, the service may be down for a while."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service des demandes ne répond pas. Vérifiez votre connexion et réessayez ; si cela échoue encore, le service est peut-être indisponible pour un moment."
          }
        }
      }
    },
    "aircraftRequest.error.invalidRegistration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That doesn’t look like a registration. Type it as it’s painted on the aircraft: HB-KFD, F-HVXA, D-EABC."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne ressemble pas à une immatriculation. Tapez-la comme elle est peinte sur l’avion : HB-KFD, F-HVXA, D-EABC."
          }
        }
      }
    },
    "aircraftRequest.error.invalidEmail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That e-mail address doesn’t look right."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse e-mail ne semble pas valide."
          }
        }
      }
    },
    "aircraftRequest.error.clubContactIsSender": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The club’s contact can’t be your own address: someone else at the club confirms. If you look after the club’s documents yourself, send it “For the club”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contact du club ne peut pas être votre propre adresse : c’est quelqu’un d’autre au club qui confirme. Si c’est vous qui vous occupez des documents du club, envoyez-la « Pour le club »."
          }
        }
      }
    },
    "aircraftRequest.error.files": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One of the files wasn’t accepted (up to 4 files, PDF, JPEG, PNG or HEIC, 10 MB each, 25 MB in all): remove it, then send again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un des fichiers n’a pas été accepté (jusqu’à 4 fichiers, PDF, JPEG, PNG ou HEIC, 10 Mo chacun, 25 Mo en tout) : retirez-le, puis envoyez à nouveau."
          }
        }
      }
    },
    "aircraftRequest.error.unknownRegistration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AéroCheck doesn’t have this registration (any more), so it can’t be an update. The form now sends it as a new aircraft: check its details, then send again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AéroCheck n’a pas (ou plus) cette immatriculation : ce ne peut donc pas être une mise à jour. Le formulaire l’envoie maintenant comme un nouvel avion : vérifiez ses détails, puis envoyez à nouveau."
          }
        }
      }
    },
    "aircraftRequest.error.knownRegistration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AéroCheck already has this registration, so the form now sends it as an update. Check it, then send again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AéroCheck a déjà cette immatriculation : le formulaire l’envoie donc maintenant comme une mise à jour. Vérifiez-le, puis envoyez à nouveau."
          }
        }
      }
    },
    "aircraftRequest.error.knownOthers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from the other registrations: %@ (already in AéroCheck). To update one, send a separate request."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À retirer des autres immatriculations : %@ (déjà dans AéroCheck). Pour en mettre une à jour, envoyez une demande à part."
          }
        }
      }
    },
    "aircraftRequest.error.listChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AéroCheck’s aircraft list changed while you filled in the form. Look the registration up again in a few minutes, then send."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste des avions d’AéroCheck a changé pendant que vous remplissiez le formulaire. Vérifiez à nouveau l’immatriculation dans quelques minutes, puis envoyez."
          }
        }
      }
    },
    "aircraftRequest.error.sizeMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A file changed while it was being sent. Add it again, then send again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier a changé pendant l’envoi. Ajoutez-le à nouveau, puis envoyez à nouveau."
          }
        }
      }
    },
    "aircraftRequest.error.turnstileFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The check that you’re not a robot didn’t go through. It has started again: wait for it to finish, then send again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification anti-robot n’est pas passée. Elle a recommencé : attendez qu’elle se termine, puis envoyez à nouveau."
          }
        }
      }
    },
    "aircraftRequest.error.uploadGone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This upload has expired (files are kept for 24 hours at most). Send the request again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet envoi a expiré (les fichiers sont conservés 24 heures au plus). Envoyez la demande à nouveau."
          }
        }
      }
    },
    "aircraftRequest.error.alreadySent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request was sent already: %@. Its link is in the e-mail we sent you."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette demande a déjà été envoyée : %@. Son lien est dans l’e-mail que nous vous avons envoyé."
          }
        }
      }
    },
    "aircraftRequest.error.payloadTooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The form is too long for the service (the notes, most likely). Shorten it, then send again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le formulaire est trop long pour le service (les remarques, sans doute). Raccourcissez-le, puis envoyez à nouveau."
          }
        }
      }
    },
    "aircraftRequest.error.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many tries from your connection in a short time. Wait a minute, then try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop d’essais depuis votre connexion en peu de temps. Attendez une minute, puis réessayez."
          }
        }
      }
    },
    "aircraftRequest.error.internal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service ran into a problem on its side. Try again in a moment; if it keeps happening, write to us."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service a rencontré un problème de son côté. Réessayez dans un moment ; si cela continue, écrivez-nous."
          }
        }
      }
    },
    "aircraftRequest.error.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests are closed for the moment (the service isn’t ready). Try again later: nothing was sent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les demandes sont fermées pour le moment (le service n’est pas prêt). Réessayez plus tard : rien n’a été envoyé."
          }
        }
      }
    },
    "aircraftRequest.error.dailyCap": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That’s all the requests we can take today. Try again tomorrow: nothing was sent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est tout ce que nous pouvons recevoir aujourd’hui. Réessayez demain : rien n’a été envoyé."
          }
        }
      }
    },
    "aircraftRequest.error.lookupUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AéroCheck’s aircraft list can’t be read right now, so the registration can’t be checked. Try again in a few minutes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste des avions d’AéroCheck ne peut pas être lue pour le moment : impossible de vérifier l’immatriculation. Réessayez dans quelques minutes."
          }
        }
      }
    },
    "aircraftRequest.error.field": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One of the fields wasn’t accepted: check the form, then send again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un des champs n’a pas été accepté : vérifiez le formulaire, puis envoyez à nouveau."
          }
        }
      }
    },
    "aircraftRequest.error.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Try again in a moment."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une erreur s’est produite. Réessayez dans un moment."
          }
        }
      }
    },
    "aircraftRequest.resultTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyée : %@"
          }
        }
      }
    },
    "aircraftRequest.resultBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We have your request and sent its link to %@: use it to follow your request. It’s also in the Aircraft tab, with its status."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons bien reçu votre demande et en avons envoyé le lien à %@ : il vous permet de la suivre. Elle figure aussi dans l’onglet Avions, avec son statut."
          }
        }
      }
    },
    "aircraftRequest.nextTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What happens next"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suite"
          }
        }
      }
    },
    "aircraftRequest.nextBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We look at it, then prepare it. That takes as long as it takes: one person does it in their spare time, with no promised date. You get an e-mail at each step that needs one."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous la regardons, puis nous la préparons. Cela prend le temps qu’il faut : une seule personne s’en occupe sur son temps libre, sans date promise. Vous recevez un e-mail à chaque étape qui en demande un."
          }
        }
      }
    },
    "aircraftRequest.nextClub": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The club’s contact has an e-mail asking them to confirm. Nothing goes live without it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contact du club a reçu un e-mail lui demandant de confirmer. Rien n’est mis en ligne sans son accord."
          }
        }
      }
    },
    "aircraftRequest.nextClubNoContact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The club hasn’t been asked yet: add its contact from the request’s page when you have it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le club n’a pas encore été sollicité : ajoutez son contact depuis la page de la demande dès que vous l’avez."
          }
        }
      }
    },
    "aircraftRequest.openPage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your request’s page"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page de votre demande"
          }
        }
      }
    },
    "aircraftRequest.entryTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send us an aircraft’s checklist"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez-nous la checklist d’un avion"
          }
        }
      }
    },
    "aircraftRequest.entrySubtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your aircraft isn’t here, or its checklist is out of date"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre avion n’est pas là, ou sa checklist n’est plus à jour"
          }
        }
      }
    },
    "aircraftRequest.menuItem": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not listed? Send us its checklist"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas dans la liste ? Envoyez-nous sa checklist"
          }
        }
      }
    },
    "aircraftRequest.proLine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can’t find your aircraft? Send us its checklist"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre avion n’y est pas ? Envoyez-nous sa checklist"
          }
        }
      }
    },
    "aircraftRequest.onboardingLine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your aircraft isn’t there? Once you’re in, send us its checklist from the Aircraft tab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre avion n’y est pas ? Une fois dans l’app, envoyez-nous sa checklist depuis l’onglet Avions."
          }
        }
      }
    },
    "circuits.skippedInCircuits": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "in Platzrunden übersprungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "skipped in circuits"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "sautée en tours de piste"
          }
        }
      }
    },
    "circuits.leaveTitle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Platzrunden verlassen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave circuits?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitter les tours de piste ?"
          }
        }
      }
    },
    "circuits.leaveMessage": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Flug ist im Platzrundenmodus, der Reiseflug und Sinkflug überspringt. Die bisher geflogenen Touch-and-gos und Full Stops bleiben im Flug."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This flight is set for circuits, which skip Cruise and Descent. The touch-and-goes and full stops flown so far stay in the flight."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce vol est en tours de piste, qui sautent la croisière et la descente. Les posés-décollés et atterrissages complets faits jusqu'ici restent dans le vol."
          }
        }
      }
    },
    "circuits.leaveAndGo": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Platzrunden verlassen, weiter: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave circuits, go to %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitter les tours de piste, puis %@"
          }
        }
      }
    },
    "circuits.stay": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Platzrunden bleiben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay in circuits"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rester en tours de piste"
          }
        }
      }
    },
    "circuits.touchAndGoLoop": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch-and-go-Schleife, von der Steigflugkontrolle bis zur Landekontrolle"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch-and-go loop, from the climb check to the landing check"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boucle du posé-décollé, de la vérification de montée à la vérification d'atterrissage"
          }
        }
      }
    },
    "circuits.fullStopLoop": {
