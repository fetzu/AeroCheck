    "flightNames.renameTripMessage": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Name gilt für die ganze Reise. Jede Etappe behält ihren eigenen Namen. Lassen Sie ihn leer, um wieder die Flugplätze der Reise anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This name is for the whole trip. Each leg keeps its own name. Leave it empty to show the trip's aerodromes again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce nom vaut pour tout le voyage. Chaque étape garde le sien. Laissez vide pour réafficher les aérodromes du voyage."
          }
        }
      }
    },
    "icaoNames.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ICAO-Codes verwenden?"
          }
