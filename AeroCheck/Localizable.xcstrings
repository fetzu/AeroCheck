    "gps.status.degraded.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das GPS-Signal ist schwach. Die Position ist ungenauer als 100 Meter, oder seit mehr als 20 Sekunden ist keine Satellitenposition eingegangen (die Position kann dann aus Wi-Fi oder Mobilfunkantennen stammen). Ihr Standort ist möglicherweise nur ungefähr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS signal is weak. Position accuracy exceeds 100 metres, or no satellite fix has been received for more than 20 seconds (the position may then come from Wi-Fi or cell towers). Your location may be approximate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le signal GPS est faible. La précision de la position dépasse 100 mètres, ou aucune position satellite n'a été reçue depuis plus de 20 secondes (la position peut alors provenir du Wi-Fi ou des antennes mobiles). Votre position peut être approximative."
          }
        }
      }
    },
    "gps.status.good.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das GPS funktioniert normal: In den letzten 20 Sekunden ist eine Satellitenposition mit einer Genauigkeit von 100 Metern oder besser eingegangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS is working normally: a satellite fix within 100 metres was received in the last 20 seconds."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le GPS fonctionne normalement : une position satellite d'une précision inférieure à 100 mètres a été reçue au cours des 20 dernières secondes."
          }
        }
      }
    },
    "gps.status.lost.description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein GPS-Signal. Seit mehr als 45 Sekunden ist keine neue Position eingegangen. Prüfen Sie, ob die Ortungsdienste in den Einstellungen eingeschaltet sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No GPS signal. No position update received for more than 45 seconds. Check that location services are enabled in Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun signal GPS. Aucune mise à jour de position reçue depuis plus de 45 secondes. Vérifiez que les services de localisation sont activés dans les Réglages."
          }
        }
      }
    },
