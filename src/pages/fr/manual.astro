---
import Base from '../../layouts/Base.astro';
import PageStub from '../../components/PageStub.astro';
import { loadSite } from '../../lib/site';
const site = loadSite('fr');
---
<Base site={site} lang="fr" title={site.nav.manual}>
  <PageStub label={site.nav.manual} heading="Manuel — bientôt"
    body="Le manuel détaillé est en cours de portage vers le nouveau site. En attendant, les notes de version GitHub couvrent les nouveautés."
    home="/fr" homeLabel="Retour à l'accueil" />
</Base>
