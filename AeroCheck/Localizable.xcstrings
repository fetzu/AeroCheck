    "nav.terrainNotCheckedDetail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Route wurde kein Geländeabstand berechnet. Die Höhendaten decken nur die Schweiz ab, und jeder Wegpunkt braucht eine geplante Höhe. Diese Route wurde nicht gegen das Gelände geprüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No terrain clearance was calculated for this route. Elevation data covers Switzerland only, and every waypoint needs a planned altitude. This route has not been checked against terrain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune marge par rapport au relief n'a été calculée pour cette route. Les données d'altitude couvrent uniquement la Suisse, et chaque point de la route doit avoir une altitude prévue. Cette route n'a pas été vérifiée par rapport au relief."
          }
        }
      }
    },
