{
  "sourceLanguage" : "en",
  "strings" : {
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AéroCheck keeps recording your flight track when the screen locks or you switch apps in flight, so landings are not missed and the logbook times are right. Without Always, recording stops as soon as the app leaves the screen. The track stays on your device and in your own iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AéroCheck continue d'enregistrer la trace de votre vol quand l'écran se verrouille ou que vous changez d'app en vol : aucun atterrissage n'est manqué et les heures du carnet de vol sont justes. Sans « Toujours », l'enregistrement s'arrête dès que l'app quitte l'écran. La trace reste sur votre appareil et dans votre propre iCloud."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AéroCheck records your flight track (position, altitude and ground speed) to draw the navigation map and fill in your logbook. The track stays on your device and in your own iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AéroCheck enregistre la trace de votre vol (position, altitude et vitesse sol) pour dessiner la carte de navigation et remplir votre carnet de vol. La trace reste sur votre appareil et dans votre propre iCloud."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AéroCheck reads the barometric altimeter to record altitude on your flight track and to detect take-offs, touch-and-gos and landings accurately. Motion data never leaves your device."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AéroCheck lit l'altimètre barométrique pour enregistrer l'altitude sur la trace de votre vol et détecter avec précision les décollages, les posés-décollés et les atterrissages. Les données de mouvement ne quittent jamais votre appareil."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AéroCheck needs access to save flight log images to your photo library."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AéroCheck a besoin de cet accès pour enregistrer les images de vos vols dans votre photothèque."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
