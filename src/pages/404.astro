---
import Base from '../layouts/Base.astro';
import PageStub from '../components/PageStub.astro';
import { loadSite } from '../lib/site';
// 404 serves every unknown route (EN and FR), so the copy is bilingual.
const site = loadSite('en');
---
<Base site={site} lang="en" title="Page not found · 404">
  <PageStub
    label="404"
    heading="Off course"
    body="This page isn’t on the chart. — Cette page n’est pas sur la carte."
    home="/"
    homeLabel="Back to AeroCheck" />
</Base>
