    "companion.pairingGuidanceMaster": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPad is the main screen. To pair, start here: \"Pair New Device\", then \"Make discoverable\", and keep that window open while the iPhone scans for it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPad est l’écran principal. Pour appairer, commencez ici : « Appairer un nouvel appareil », puis « Rendre détectable », et gardez cette fenêtre ouverte pendant que l’iPhone le recherche."
          }
        }
      }
    },
    "companion.pairingGuidanceViewer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iPhone connects to your iPad. To pair, start on the iPad: \"Pair New Device\", then \"Make discoverable\", and keep that window open. Then, here: \"Pair New Device\", then \"Scan for Devices\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone se connecte à votre iPad. Pour appairer, commencez sur l’iPad : « Appairer un nouvel appareil », puis « Rendre détectable », et gardez cette fenêtre ouverte. Ensuite, ici : « Appairer un nouvel appareil », puis « Rechercher des appareils »."
          }
        }
      }
    },
    "companion.pairingMasterDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start here: tap \"Make discoverable\" and keep the window that opens on screen. Then, on the iPhone, tap \"Pair New Device\", then \"Scan for Devices\", choose this iPad and confirm the code on both."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez ici : touchez « Rendre détectable » et gardez à l’écran la fenêtre qui s’ouvre. Ensuite, sur l’iPhone, touchez « Appairer un nouvel appareil », puis « Rechercher des appareils », choisissez cet iPad et confirmez le code sur les deux appareils."
          }
        }
      }
    },
    "companion.pairingPausesLink": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While this screen is open, the companion link is paused. Once the devices are paired, or paired again, the screen closes by itself and the link comes back on its own."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que cet écran est ouvert, le lien avec le compagnon est en pause. Une fois les appareils appairés, ou appairés à nouveau, l’écran se ferme de lui-même et le lien revient tout seul."
          }
        }
      }
    },
    "companion.pairingViewerDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start on the iPad: \"Pair New Device\", then \"Make discoverable\", and keep that window open. Then tap \"Scan for Devices\" below, choose the iPad and confirm the code on both."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez sur l’iPad : « Appairer un nouvel appareil », puis « Rendre détectable », et gardez cette fenêtre ouverte. Touchez ensuite « Rechercher des appareils » ci-dessous, choisissez l’iPad et confirmez le code sur les deux appareils."
          }
        }
      }
    },
