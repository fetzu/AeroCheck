    "alert.proNotActive.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AéroCheck Pro ist nicht aktiv"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AéroCheck Pro isn't active"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
