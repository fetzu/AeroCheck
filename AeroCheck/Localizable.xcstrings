    "dryRunCoach.habit1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start the flight before the engine: the app times everything from that moment."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez le vol avant la mise en marche : l'app chronomètre tout à partir de ce moment."
          }
        }
      }
    },
    "dryRunCoach.habit2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first button always shows the next check, and nothing you defer is lost."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier bouton montre toujours la prochaine vérification, et rien de ce que vous reportez n'est perdu."
          }
        }
      }
    },
    "dryRunCoach.habit3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One tap at the holding point, then both hands on the aircraft."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appui au point d'attente, puis les deux mains sur l'avion."
          }
        }
      }
    },
    "dryRunCoach.habit4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In flight, the app follows along: you only tap when it asks you to."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En vol, l'app suit : vous ne touchez que lorsqu'elle vous le demande."
          }
        }
      }
    },
    "dryRunCoach.habit5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quick glance is enough: what matters is at the top of the screen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un coup d'œil suffit : l'essentiel est en haut de l'écran."
          }
        }
      }
    },
    "dryRunCoach.habit6": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fly first: a check can wait, and the app keeps them in order."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilotez d'abord : une vérification peut attendre, et l'app les garde dans l'ordre."
          }
        }
      }
    },
    "dryRunCoach.habit7": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app prepares the logbook entry: read it over once you are on the ground."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app prépare l'entrée de carnet : relisez-la une fois au sol."
          }
        }
      }
    },
    "dryRunCoach.habitClose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close a filed flight plan first; the rest can wait until the evening."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clôturez d'abord un plan de vol déposé ; le reste peut attendre le soir."
          }
        }
      }
    },
    "dryRunCoach.habitLogbook": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The entry is a draft: read it over, then copy it into your logbook."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'entrée est un brouillon : relisez-la, puis reportez-la dans votre carnet."
          }
        }
      }
    },
    "dryRunCoach.habitPlan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One page per flight, with the next thing to do always at the top."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
