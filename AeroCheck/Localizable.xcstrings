      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next, your logbook: the flight you just flew, with its track and its checks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite, votre carnet : le vol que vous venez de faire, avec sa trace et ses vérifications."
          }
        }
      }
    },
    "dryRunCoach.onTo": {
      "extractionState": "manual",
