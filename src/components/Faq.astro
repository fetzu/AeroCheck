---
// The questions a pilot asks before installing (6.4.0 site, Q9), as native disclosure widgets: no script.
import type { Qa } from '../lib/site';
interface Props { heading: string; items: Qa[]; privacyHref: string; }
const { heading, items, privacyHref } = Astro.props;
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// The answer that names the privacy policy links it, and an address on this site written in an answer
// (aerocheck.app/send, aerocheck.app/fr/countries) is a link to that page, its text as written.
const answer = (t: string) => esc(t)
  .replace(/privacy policy|Datenschutzerklärung|politique de confidentialité/, (m) => `<a href="${privacyHref}">${m}</a>`)
  .replace(/aerocheck\.app(\/[a-z]+)+/g, (m) => `<a href="${m.slice('aerocheck.app'.length)}">${m}</a>`);
---
<section id="faq" class="faq reveal">
  <div class="container">
    <h2 class="sec-title">{heading}</h2>
    <div class="qa">
      {items.map((it, i) => (
        <details open={i === 0}>
          <summary>{it.q}</summary>
          <p set:html={answer(it.a)} />
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { padding: 48px 0 32px; scroll-margin-top: 72px; }
  .sec-title { font-size: clamp(26px, 3.4vw, 34px); margin-bottom: 20px; }
  .qa { display: grid; grid-template-columns: 1fr 1fr; gap: 0 44px; }
  details { border-top: 1px solid var(--line-2); padding: 16px 0; }
  summary { cursor: pointer; font-weight: 700; font-size: 16.5px; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: "+"; font-family: var(--mono); color: var(--gold); flex: none; }
  details[open] summary::after { content: "−"; }
  summary:focus-visible { outline: 2px solid var(--cyan); outline-offset: 4px; border-radius: 4px; }
  details p { margin: 10px 0 0; color: var(--muted); line-height: 1.65; font-size: 15px; max-width: 60ch; }
  details p :global(a) { color: var(--cyan); }
  @media (max-width: 820px) { .qa { grid-template-columns: 1fr; } }
</style>
