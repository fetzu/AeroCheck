    "thread.cancelConfirm.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Seite und seine Aufgaben werden gelöscht, mit der für ihn erstellten Kopie der Route. Ihre Routen und das Flugbuch bleiben unberührt. Dies lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its page and tasks are deleted, with the copy of the route made for it. Your routes and the logbook are not touched. This can't be undone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa page et ses tâches sont supprimées, avec la copie de la route faite pour ce vol. Vos routes et le carnet de vol ne sont pas touchés. Cette action est irréversible."
          }
        }
      }
    },
