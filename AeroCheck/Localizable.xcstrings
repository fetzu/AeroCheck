    "alert.proNotActive.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ braucht ein aktives Abonnement für AéroCheck Pro, und dieses Gerät kann keines bestätigen: Es ist möglicherweise abgelaufen. Wenn Sie es erneuert oder auf einem anderen Gerät gekauft haben, stellen Sie Ihre Käufe wieder her."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ needs an active AéroCheck Pro subscription, and this device can't confirm one: it may have expired. If you renewed it, or bought it on another device, restore your purchases."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nécessite un abonnement AéroCheck Pro actif, et cet appareil ne peut pas en confirmer un : il a peut-être expiré. Si vous l'avez renouvelé, ou acheté sur un autre appareil, restaurez vos achats."
          }
        }
      }
    },
    "alert.proNotActive.seePlans": {
