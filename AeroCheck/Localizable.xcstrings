    "trip.cancelConfirm.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Etappen der Reise werden gelöscht, mit ihren Seiten, Aufgaben und den für sie erstellten Kopien der Route:\n\n%@\n\nIhre Routen und das Flugbuch bleiben unberührt. Dies lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its legs are deleted, with their pages, tasks and the copies of the route made for them:\n\n%@\n\nYour routes and the logbook are not touched. This can't be undone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses étapes sont supprimées, avec leurs pages, leurs tâches et les copies de la route faites pour elles :\n\n%@\n\nVos routes et le carnet de vol ne sont pas touchés. Cette action est irréversible."
          }
        }
      }
    },
    "trip.cancelConfirm.messageKeepsFlown": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die noch nicht geflogenen Etappen werden gelöscht, mit ihren Seiten, Aufgaben und den für sie erstellten Kopien der Route:\n\n%@\n\nDie bereits geflogenen Etappen bleiben, mit ihren Flügen im Flugbuch. Ihre Routen bleiben unberührt. Dies lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The legs not flown yet are deleted, with their pages, tasks and the copies of the route made for them:\n\n%@\n\nThe legs already flown stay, with their flights in the logbook. Your routes are not touched. This can't be undone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les étapes pas encore volées sont supprimées, avec leurs pages, leurs tâches et les copies de la route faites pour elles :\n\n%@\n\nLes étapes déjà volées restent, avec leurs vols dans le carnet de vol. Vos routes ne sont pas touchées. Cette action est irréversible."
          }
        }
      }
    },
