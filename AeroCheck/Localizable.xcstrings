          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-stop loop, from the before take-off check to the after landing check"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boucle de l'atterrissage complet, de la vérification avant départ à la vérification après atterrissage"
