---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import FeatureRow from '../components/FeatureRow.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Pills from '../components/Pills.astro';
import { loadSite } from '../lib/site';
import { loadFleetCounts, applyFleetTokensDeep } from '../lib/fleet';
// Fleet figures come from the API, never from the copy. The home page used to state them
// as prose and drifted the moment a tail was added; the /aircraft page never did, because
// it derives. Same source now.
const site = applyFleetTokensDeep(loadSite('en'), await loadFleetCounts());
---
<Base site={site} lang="en">
  <Hero site={site} />

  <section id="features" class="flagship">
    <div class="container">
      <div class="section-head">
        <span class="section-label">{site.flagship.heading}</span>
      </div>
      {site.flagship.items.map((item, i) => <FeatureRow item={item} index={i} />)}
    </div>
  </section>

  <section class="supporting">
    <div class="container">
      <div class="section-head"><span class="section-label">{site.supporting.heading}</span></div>
      <FeatureGrid items={site.supporting.items} />
      <div class="pills-wrap"><Pills items={site.ecosystem} /></div>
    </div>
  </section>
</Base>

<style>
  .flagship { padding-top: 24px; }
  .supporting { background: var(--bg-band); border-top: 1px solid var(--line); }
  .pills-wrap { margin-top: 14px; }
</style>
