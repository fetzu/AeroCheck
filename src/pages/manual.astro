---
import Base from '../layouts/Base.astro';
import Manual from '../components/Manual.astro';
import { Content, getHeadings } from '../manual/manual.en.md';
import { loadSite } from '../lib/site';
const site = loadSite('en');
const headings = getHeadings();
---
<Base site={site} lang="en" title={site.nav.manual}>
  <Manual lang="en" headings={headings}><Content /></Manual>
</Base>
