    "altitudes.footnote": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abflug- und Zielflugplatz behalten ihre Höhe. Die erste und die letzte Teilstrecke werden als gerader Steig- und Sinkflug gezeichnet, ihr Abstand hängt also von der Steigleistung ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Departure and destination keep their altitude. The first and last legs are drawn as straight climbs and descents, so their clearance depends on climb performance."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le départ et la destination gardent leur altitude. La première et la dernière branche sont tracées en montée et descente linéaires : leur marge dépend des performances de montée."
          }
        }
      }
    },
