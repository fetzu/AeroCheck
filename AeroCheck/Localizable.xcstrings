    "alert.flightSaveFailed.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Flug konnte nicht gespeichert werden (auf Ihrem Gerät ist möglicherweise zu wenig Speicher frei). Er wurde aufbewahrt und wird beim nächsten Öffnen der App wiederhergestellt, damit Sie es erneut versuchen können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This flight couldn't be saved to storage (your device may be low on space). It has been kept and will be restored the next time you open the app so you can try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce vol n'a pas pu être enregistré (l'espace de stockage de votre appareil est peut-être insuffisant). Il a été conservé et sera restauré au prochain démarrage de l'application pour que vous puissiez réessayer."
          }
        }
      }
    },
    "alert.flightSaveFailed.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flug nicht gespeichert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flight Not Saved"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vol non enregistré"
          }
        }
      }
    },
    "alert.locationOff.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standort ist ausgeschaltet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location Is Off"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Localisation désactivée"
          }
        }
      }
    },
    "alert.locationOff.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AéroCheck kann den Standort dieses Geräts nicht verwenden: Dieser Flug zeichnet keinen Flugweg auf, und Starts und Landungen werden nicht erkannt. Die Checklisten funktionieren wie gewohnt. Um den Flug aufzuzeichnen, schalten Sie den Standort für AéroCheck in den Einstellungen ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AéroCheck can’t use this device’s location: this flight won’t record a track, and take-offs and landings won’t be detected. The checklists work as usual. To record the flight, turn location on for AéroCheck in Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AéroCheck ne peut pas utiliser la position de cet appareil : ce vol n’enregistrera pas de trace, et les décollages et atterrissages ne seront pas détectés. Les checklists fonctionnent comme d’habitude. Pour enregistrer le vol, activez la localisation pour AéroCheck dans Réglages."
          }
        }
      }
    },
