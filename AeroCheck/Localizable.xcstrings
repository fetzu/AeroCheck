    "settings.developer.marketingModeDesc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Marketing Mode: When enabled, shake your device to show the marketing location controls overlay. This allows you to simulate GPS positions for taking screenshots."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode marketing : Lorsqu'activé, secouez votre appareil pour afficher les contrôles de localisation marketing. Cela vous permet de simuler des positions GPS pour prendre des captures d'écran."
          }
        }
      }
    },
    "settings.developer.forceNotSubscribedDesc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force 'Not Subscribed': Ignores actual subscription status and pretends you're not subscribed. Useful for testing the free experience even with an active subscription."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forcer 'Non abonné' : Ignore le statut réel de l'abonnement et prétend que vous n'êtes pas abonné. Utile pour tester l'expérience gratuite même avec un abonnement actif."
          }
        }
      }
    },
    "settings.developer.showAllTransactionsDesc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show All Transactions: Displays all StoreKit transactions for debugging subscription issues."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher toutes les transactions : Affiche toutes les transactions StoreKit pour déboguer les problèmes d'abonnement."
          }
        }
      }
