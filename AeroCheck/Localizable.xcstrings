    "planFlight.routeLegsExplainer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Etappe behält ihren Teil der Route und wird ein eigener Flug, mit eigenem Nav-Log, ATC-Flugplan und eigener Flugbuchzeile. Wetter, NOTAM und DABS werden einmal für die ganze Reise vorbereitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each leg keeps its part of the route and becomes a separate flight, with its own nav log, ATC flight plan and logbook line. Weather, NOTAM and DABS are prepared once for the whole trip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque étape garde sa part de la route et devient un vol distinct, avec son log de navigation, son plan de vol ATC et sa ligne dans le carnet de vol. Météo, NOTAM et DABS se préparent une seule fois pour tout le voyage."
          }
        }
      }
    },
    "planFlight.routeLandingAt": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, mit Landung in %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, landing at %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, avec escale à %2$@"
          }
        }
      }
    },
    "planFlight.legsTotalRoute": {
