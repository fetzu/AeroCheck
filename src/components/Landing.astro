---
// The landing page, shared by / and /fr/ (6.4.0 site). Product first: the first screen says what AéroCheck is,
// for whom, on what and at what cost, and shows the Cockpit with what each part is for. Then the way in (the dry
// run), the shape of a flight (the four chapters, with the link to one real flight told in order on /flight),
// the rows, the FLY ones and the iPhone in the flight-deck band, what it costs, the questions, and the long tail.
import { langBase } from '../lib/langs';
import { coverageCounts, loadReleasedCoverage } from '../lib/coverage';
import type { SiteData } from '../lib/site';
import Hero from './Hero.astro';
import DryRunBand from './DryRunBand.astro';
import ChapterStrip from './ChapterStrip.astro';
import FeatureRow from './FeatureRow.astro';
import PhoneBand from './PhoneBand.astro';
import Pricing from './Pricing.astro';
import Faq from './Faq.astro';
import AlsoLine from './AlsoLine.astro';
interface Props { site: SiteData; }
const { site } = Astro.props;
const base = langBase(site.lang);
const local = (href: string) => (href.startsWith('/') && !href.startsWith('//') ? `${base}${href}` : href);
const items = site.flagship.items.map((item, index) => ({ item, index }));
const before = items.filter(({ item }, i) => !item.fly && items.slice(i).some(({ item: later }) => later.fly));
const fly = items.filter(({ item }) => item.fly);
const after = items.filter(({ item }, i) => !item.fly && !before.some((b) => b.index === i));
const dry = { ...site.dryrun, link: { ...site.dryrun.link, href: local(site.dryrun.link.href) } };
const story = { ...site.chapters.story, href: local(site.chapters.story.href) };
const links = site.pricing.links.map((l) => ({ ...l, href: local(l.href) }));
// What works where, under the chapters: the counts from the server's coverage file, a clause only when it counts more
// than one country (before a release, the briefing pages are Switzerland's alone).
const counts = coverageCounts(await loadReleasedCoverage());
const line = site.countries.home_line;
const clauses = ([['briefing', counts.briefingCountries], ['circuits', counts.circuitCountries], ['charts', counts.chartCountries]] as const)
  .filter(([, n]) => n > 1).map(([key, n]) => line[key].replace('{n}', String(n)));
const whereText = [line.lead, clauses.length ? clauses.join(', ').replace(/^./, (c) => c.toUpperCase()) + '.' : ''].filter(Boolean).join(' ');
const where = { text: whereText, link: { label: line.link, href: local('/countries') } };
const whereRow = { label: site.countries.where, href: local('/countries') };
---
<Hero site={site} />
<DryRunBand dry={dry} lang={site.lang} />
<ChapterStrip heading={site.chapters.heading} items={site.chapters.items} story={story} where={where} />

<section id="features" class="flagship">
  <div class="container">
    <div class="section-head"><span class="section-label">{site.flagship.heading}</span></div>
    {before.map(({ item, index }) => <FeatureRow item={item} index={index} labels={site.device_labels} where={whereRow} lang={site.lang} />)}
  </div>
  <div class="fly-band">
    <div class="container">
      {fly.map(({ item, index }) => <FeatureRow item={item} index={index} labels={site.device_labels} where={whereRow} lang={site.lang} />)}
      <PhoneBand band={site.phone} labels={site.device_labels} lang={site.lang} />
    </div>
  </div>
  <div class="container">
    {after.map(({ item, index }) => <FeatureRow item={item} index={index} labels={site.device_labels} where={whereRow} lang={site.lang} />)}
  </div>
</section>

<Pricing heading={site.pricing.heading} tiers={site.pricing.tiers} send={site.pricing.send} links={links} />
<Faq heading={site.faq.heading} items={site.faq.items} privacyHref={local('/privacy')} />
<AlsoLine label={site.also.label} items={site.also.items} />

<style>
  .flagship { padding-top: 24px; padding-bottom: 0; }
  /* The FLY band: the flight-deck cyan the app switches to at take-off, as a faint wash in either theme. */
  .fly-band { border-top: 1px solid color-mix(in srgb, var(--cyan-fill) 32%, transparent); border-bottom: 1px solid color-mix(in srgb, var(--cyan-fill) 20%, transparent);
    background: linear-gradient(180deg, color-mix(in srgb, var(--cyan-fill) 8%, transparent), color-mix(in srgb, var(--cyan-fill) 2%, transparent) 55%, transparent); }
  .flagship .container > :global(:last-child) { border-bottom: 0; }
</style>
