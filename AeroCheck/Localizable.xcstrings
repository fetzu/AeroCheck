    "dryRunCoach.nextClose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next, closing out the flight: the logbook line, the cost and the debrief."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
