{
  "sourceLanguage": "en",
  "strings": {
    "%@: time to check the weather, DABS and any PPR.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: Zeit, Wetter, DABS und allfällige PPR zu prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : il est temps de vérifier la météo, le DABS et les éventuels PPR."
          }
        }
      }
    },
    "%lld images: this card first, then one for each leg": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Bilder: zuerst dieses, dann eines pro Etappe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld images : cette carte d’abord, puis celle de chaque étape"
          }
        }
      }
    },
    "%lld stop-and-go": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Stop-and-go"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Stop-and-gos"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld stop-and-go"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld stop-and-goes"
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld stop-and-go"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld stop-and-go"
                }
              }
            }
          }
        }
      }
    },
    "%lld full stops": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Full Stop"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Full Stops"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld full stop"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld full stops"
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld atterrissage complet"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld atterrissages complets"
                }
              }
            }
          }
        }
      }
    },
    "%lld touch-and-goes and go-arounds": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Touch-and-go oder Durchstart"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Touch-and-gos und Durchstarts"
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld touch-and-go or go-around"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld touch-and-goes and go-arounds"
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld posé-décollé ou remise de gaz"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld posés-décollés et remises de gaz"
                }
              }
            }
          }
        }
      }
    },
    "A draft for your logbook: AeroCheck is not a logbook of record": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Entwurf für Ihr Flugbuch: AeroCheck ist kein offizielles Flugbuch"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un brouillon pour votre carnet : AéroCheck n'est pas un carnet de vol officiel"
          }
        }
      }
    },
    "A reminder, not a clearance: the authority's page is the reference": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erinnerung, keine Freigabe: Massgebend ist die Seite der Behörde"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel, pas une autorisation : la page de l'autorité fait foi"
          }
        }
      }
    },
    "Advisory only: check against the load sheet and the AFM": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unverbindlich: mit der Masse- und Schwerpunktberechnung und dem AFM abgleichen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À titre indicatif : à vérifier avec le devis de masse et centrage et le manuel de vol"
          }
        }
      }
    },
    "AeroCheck follows a flight end to end: plan it, prepare it, fly it, close it out.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AéroCheck suit un vol de bout en bout : planifiez-le, préparez-le, volez, clôturez-le."
          }
        }
      }
    },
    "AéroCheck is fully featured out of the box, with the WT9 Dynamic included free. AéroCheck Pro unlocks every other aircraft: the full fleet of the partner flying clubs, listed on aerocheck.app.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AéroCheck est entièrement fonctionnelle dès le départ, avec le WT9 Dynamic inclus gratuitement. AéroCheck Pro débloque tous les autres avions : la flotte complète des aéroclubs partenaires, listée sur aerocheck.app."
          }
        }
      }
    },
    "Border crossing: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grenzübertritt: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passage de frontière : %@"
          }
        }
      }
    },
    "COLOUR THEME": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FARBSCHEMA"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "THÈME DE COULEUR"
          }
        }
      }
    },
    "Checked %@, re-check for this leg": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifié à %@, à revérifier pour cette étape"
          }
        }
      }
    },
    "Choose the Swiss and worldwide layers shown on the moving map.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les calques suisses et mondiaux affichés sur la carte mobile."
          }
        }
      }
    },
    "Circuits at %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tours de piste à %@"
          }
        }
      }
    },
    "Download what you'll fly over so it works offline.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez ce que vous survolerez pour l'utiliser hors ligne."
          }
        }
      }
    },
    "Enter night and IFR time yourself: the app does not compute twilight": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie Nacht- und IFR-Zeit selbst ein: Die App berechnet die Dämmerung nicht"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez vous-même le temps de nuit et IFR : l'app ne calcule pas le crépuscule"
          }
        }
      }
    },
    "Everything ticked, ready to fly": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles abgehakt, bereit zum Fliegen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est coché, prêt à voler"
          }
        }
      }
    },
    "FAVOURITES": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FAVORITEN"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FAVORIS"
          }
        }
      }
    },
    "Favourite": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Favori"
          }
        }
      }
    },
    "Fees: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxen: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxes : %@"
          }
        }
      }
    },
    "Fly|Work the checklists through all 16 phases, pre-flight to shutdown.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voler|Déroulez les checklists des 16 phases, du prévol à l'arrêt moteur."
          }
        }
      }
    },
    "Follow a flight from planning to logbook: fuel, weather, customs, then the numbers": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolgen Sie einen Flug von der Planung bis zum Flugbuch: Treibstoff, Wetter, Zoll, dann die Zahlen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivez un vol de la planification au carnet : carburant, météo, douane, puis les chiffres"
          }
        }
      }
    },
    "If a requirement is not established, assume it applies until you have checked": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ist eine Anforderung nicht geklärt, gehen Sie davon aus, dass sie gilt, bis Sie sie geprüft haben"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si une exigence n'est pas établie, considérez qu'elle s'applique jusqu'à vérification"
          }
        }
      }
    },
    "Interactive checklists for all 16 flight phases. Choose how you run them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des checklists interactives pour les 16 phases de vol. Choisissez comment les utiliser."
          }
        }
      }
    },
    "Leaves out the first 300 m of the first leg and the last 300 m of the last leg": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt die ersten 300 m der ersten Etappe und die letzten 300 m der letzten Etappe weg"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire les 300 premiers mètres de la première étape et les 300 derniers de la dernière"
          }
        }
      }
    },
    "Log|Every flight is recorded automatically: times, track and landings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer|Chaque vol est enregistré automatiquement : heures, trace et atterrissages."
          }
        }
      }
    },
    "MTOM": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MTOM"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MTOM"
          }
        }
      }
    },
    "No envelope entered: mass and CG only": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Schwerpunktbereich eingegeben: nur Masse und Schwerpunkt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun domaine saisi : masse et centrage seulement"
          }
        }
      }
    },
    "Not checked for this country yet: see the AIP and the national customs authority": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Land noch nicht geprüft: siehe AIP und nationale Zollbehörde"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore vérifié pour ce pays : consultez l'AIP et la douane nationale"
          }
        }
      }
    },
    "OFF-BLOCK": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OFF-BLOCK"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BLOC OFF"
          }
        }
      }
    },
    "ON-BLOCK": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ON-BLOCK"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BLOC ON"
          }
        }
      }
    },
    "OVER MTOM": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MTOM ÜBERSCHRITTEN"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MTOM DÉPASSÉE"
          }
        }
      }
    },
    "Off hides the landing-fee tasks. Your logbook line is unaffected.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : les tâches de taxes d'atterrissage sont masquées. Votre ligne de carnet n'est pas affectée."
          }
        }
      }
    },
    "One aircraft free: unlock the rest": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un avion gratuit : débloquez les autres"
          }
        }
      }
    },
    "OpenAIP · optional chart imagery. Warnings come from the airspace data above.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAIP · imagerie de carte optionnelle. Les alertes viennent des données d’espace aérien ci-dessus."
          }
        }
      }
    },
    "PPR: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PPR: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PPR : %@"
          }
        }
      }
    },
    "Plan|Build your route on the map, with airspace and terrain in view.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifier|Construisez votre route sur la carte, avec les espaces aériens et le relief en vue."
          }
        }
      }
    },
    "Prior permission required: call ahead": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorherige Bewilligung nötig: rufen Sie im Voraus an"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisation préalable requise : appelez à l'avance"
          }
        }
      }
    },
    "Route forecast (opens MeteoSwiss)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streckenprognose (öffnet MeteoSchweiz)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévision de route (ouvre MétéoSuisse)"
          }
        }
      }
    },
    "Some stations have no mass, so this is not a valid check": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Positionen haben keine Masse, daher ist dies keine gültige Prüfung"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains postes n'ont pas de masse : ce n'est donc pas une vérification valable"
          }
        }
      }
    },
    "Subscription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnement"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnement"
          }
        }
      }
    },
    "Switches to the high-contrast palette when the screen is near full brightness. The app can't measure ambient light, so it goes by the screen brightness.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe à la palette à contraste élevé lorsque l'écran est proche de la luminosité maximale. L'app ne peut pas mesurer la lumière ambiante : elle se fie donc à la luminosité de l'écran."
          }
        }
      }
    },
    "These are the same values, in your logbook's column order. Scroll sideways for the other columns, and use Edit to correct them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies sind dieselben Werte, in der Spaltenreihenfolge Ihres Flugbuchs. Scrollen Sie seitwärts für die übrigen Spalten, und korrigieren Sie sie mit Bearbeiten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont les mêmes valeurs, dans l'ordre des colonnes de votre carnet. Faites défiler latéralement pour les autres colonnes, et utilisez Modifier pour les corriger."
          }
        }
      }
    },
    "These figures come from the aircraft's weighing report and AFM. The app does not include them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Werte stammen aus dem Wägebericht und dem AFM des Flugzeugs. Die App liefert sie nicht mit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces valeurs viennent de la fiche de pesée et du manuel de vol. L'app ne les fournit pas."
          }
        }
      }
    },
    "This data comes from the community, so keep it up to date. It is not official aeronautical information: always check that it is current before flight.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces données viennent de la communauté : gardez-les à jour. Ce ne sont pas des informations aéronautiques officielles ; vérifiez toujours qu’elles sont à jour avant le vol."
          }
        }
      }
    },
    "Times are UTC, from off-block and on-block times": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeiten in UTC, aus der Abblock- und der Anblockzeit"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heures en UTC, d'après les heures bloc (bloc OFF et bloc ON)"
          }
        }
      }
    },
    "Unfavourite": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus Favoriten entfernen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer des favoris"
          }
        }
      }
    },
    "Updates & offline storage": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mises à jour et stockage hors ligne"
          }
        }
      }
    },
    "Used for the PIC column and for the holder's name on the logbook PDF.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé pour la colonne PIC et pour le nom du titulaire sur le PDF du carnet."
          }
        }
      }
    },
    "Your ATC flight plan for %@ is not marked closed. If the tower did not close it for you, Zurich RCC is alerted 30 min after your ETA.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr ATC-Flugplan für %@ ist nicht als geschlossen markiert. Hat der Tower ihn nicht für Sie geschlossen, wird das RCC Zürich 30 min nach Ihrer ETA alarmiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre plan de vol ATC pour %@ n'est pas marqué comme clôturé. Si la tour ne l'a pas clôturé pour vous, le RCC de Zurich est alerté 30 min après votre ETA."
          }
        }
      }
    },
    "aircraftRequest.requestsSection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your requests"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos demandes"
          }
        }
      }
    },
    "aircraftRequest.requestsFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The status of each request is updated when you open the app. Our e-mails tell you too, and tapping a request opens its page, with its history."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le statut de chaque demande est mis à jour à l’ouverture de l’app. Nos e-mails vous l’indiquent aussi, et toucher une demande ouvre sa page, avec son historique."
          }
        }
      }
    },
    "aircraftRequest.removeFromList": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from this list"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
