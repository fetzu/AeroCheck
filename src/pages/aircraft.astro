---
import Base from '../layouts/Base.astro';
import PageStub from '../components/PageStub.astro';
import { loadSite } from '../lib/site';
const site = loadSite('en');
---
<Base site={site} lang="en" title={site.nav.aircraft}>
  <PageStub label={site.nav.aircraft} heading="Aircraft list — coming soon"
    body="The full roster — WT9 Dynamic plus 12 premium aircraft from two Swiss flying clubs — is being rebuilt for the new site."
    home="/" homeLabel="Back home" />
</Base>
