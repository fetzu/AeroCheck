        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plant die nächste Etappe dieser Reise ab %1$@ und kehrt auf Ihre Route nach %2$@ zurück. Wetter und NOTAM sind wieder nicht abgehakt: Prüfen Sie sie nach diesem Ausweichen."
          }
        },
