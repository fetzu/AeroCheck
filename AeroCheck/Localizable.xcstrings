    "dryRunCoach.storyNothingKept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing from the dry run was kept: its logbook is gone, and yours is unchanged."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien du vol à blanc n'a été gardé : son carnet a disparu, et le vôtre n'a pas changé."
          }
        }
      }
    },
    "dryRunCoach.storyRow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first flight, from plan to logbook"
          }
