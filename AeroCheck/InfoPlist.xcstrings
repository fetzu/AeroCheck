{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AéroCheck verwendet die Kamera, um die Checkliste Ihres Flugzeugs zu erfassen, wenn Sie sie uns senden. Die Seiten gehen erst an AéroCheck, wenn Sie die Anfrage senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AéroCheck uses the camera to scan your aircraft’s checklist when you send it to us. The pages go to AéroCheck only when you send the request."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AéroCheck utilise l’appareil photo pour numériser la checklist de votre avion quand vous nous l’envoyez. Les pages ne partent vers AéroCheck que lorsque vous envoyez la demande."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AéroCheck zeichnet Ihren Flug weiter auf, wenn sich der Bildschirm sperrt oder Sie die App wechseln, damit keine Landung verloren geht und die Zeiten im Flugbuch stimmen; ohne «Immer» endet die Aufzeichnung, sobald die App den Bildschirm verlässt. Der Flugweg bleibt auf Ihrem Gerät und, wenn Sie synchronisieren, in Ihrer eigenen iCloud. Wetter-, Gelände- und Luftraumdienste erhalten nur gerundete Positionen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AéroCheck keeps recording your flight when the screen locks or you switch apps, so no landing is missed and the logbook times are right; without Always, recording stops when the app leaves the screen. The track stays on your device, and in your own iCloud if you sync. Weather, terrain and airspace services only receive rounded positions."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AéroCheck continue d'enregistrer votre vol quand l'écran se verrouille ou que vous changez d'app, pour ne manquer aucun atterrissage et avoir des heures de carnet justes ; sans « Toujours », l'enregistrement s'arrête dès que l'app quitte l'écran. La trace reste sur votre appareil, et dans votre propre iCloud si vous synchronisez. Les services de météo, de relief et d'espaces aériens ne reçoivent que des positions arrondies."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AéroCheck zeichnet den Flugweg Ihres Flugs auf (Position, Höhe und Geschwindigkeit über Grund), um die Navigationskarte zu zeichnen und Ihr Flugbuch auszufüllen. Der Flugweg bleibt auf Ihrem Gerät und, wenn Sie synchronisieren, in Ihrer eigenen iCloud. Wetter-, Gelände- und Luftraumdienste erhalten nur gerundete Positionen, um die Daten für den Ort zu zeigen, an dem Sie fliegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AéroCheck records your flight track (position, altitude and ground speed) to draw the navigation map and fill in your logbook. The track stays on your device, and in your own iCloud if you sync. Weather, terrain and airspace services only receive rounded positions, to show data for where you fly."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AéroCheck enregistre la trace de votre vol (position, altitude et vitesse sol) pour dessiner la carte de navigation et remplir votre carnet de vol. La trace reste sur votre appareil, et dans votre propre iCloud si vous synchronisez. Les services de météo, de relief et d'espaces aériens ne reçoivent que des positions arrondies, pour afficher les données de l'endroit où vous volez."
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AéroCheck liest den barometrischen Höhenmesser, um die Höhe auf Ihrem Flugweg aufzuzeichnen und Starts, Touch-and-gos und Landungen genau zu erkennen. Bewegungsdaten verlassen Ihr Gerät nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AéroCheck reads the barometric altimeter to record altitude on your flight track and to detect take-offs, touch-and-gos and landings accurately. Motion data never leaves your device."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AéroCheck lit l'altimètre barométrique pour enregistrer l'altitude sur la trace de votre vol et détecter avec précision les décollages, les posés-décollés et les atterrissages. Les données de mouvement ne quittent jamais votre appareil."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AéroCheck braucht diesen Zugriff, um Bilder Ihrer Flüge in Ihrer Fotomediathek zu speichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "AéroCheck needs access to save flight log images to your photo library."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AéroCheck a besoin de cet accès pour enregistrer les images de vos vols dans votre photothèque."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
