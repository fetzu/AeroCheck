---
import Base from '../layouts/Base.astro';
import DryRun from '../components/DryRun.astro';
import { loadSite } from '../lib/site';
import { loadSiteCounts, applySiteTokensDeep } from '../lib/fleet';
const site = applySiteTokensDeep(loadSite('en'), await loadSiteCounts());
---
<Base site={site} lang="en" title={site.dry_run.meta.title} description={site.dry_run.meta.description}>
  <DryRun site={site} />
</Base>
