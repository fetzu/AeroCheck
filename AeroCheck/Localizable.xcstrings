      "comment": "The speed value, optionally prefixed with \"~\" to indicate an estimated value.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@%2$lld"
          }
        }
      }
    },
