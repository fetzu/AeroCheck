    "planFlight.noAirportData": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten der Flugplätze sind nicht geladen, daher können die Flugplätze nicht geprüft werden. Der Flug wird ohne Route erstellt; Sie können sie später zeichnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The airport data isn't loaded, so the aerodromes can't be checked. The flight is created without a route, which you can draw later."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données des aéroports ne sont pas chargées, les aérodromes ne peuvent donc pas être vérifiés. Le vol est créé sans route, que vous pourrez tracer plus tard."
          }
        }
      }
    },
