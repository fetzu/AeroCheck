---
// The first screen: what AéroCheck is, for whom, on what and at what cost, then the Cockpit itself, large,
// with what each part is for beside it. Nothing sits on the screenshot but the thin lines that lead to the
// labels; on a narrow screen the labels go under it, each saying where to look. No rotating screens. (6.4.0)
import type { SiteData } from '../lib/site';
import { shot, warnIfShotsAreOld } from '../lib/shots';
import StoreBadge from './StoreBadge.astro';
import Callouts from './Callouts.astro';
interface Props { site: SiteData; }
const { site } = Astro.props;
const h = site.hero;
const cockpit = shot(h.shot);
await warnIfShotsAreOld();
---
<section class="hero">
  <div class="container">
    <div class="hero-copy">
      <p class="eyebrow">{h.eyebrow}</p>
      <h1 class="hero-title">{h.title}</h1>
      <p class="hero-sub">{h.subtitle}</p>
      <div class="hero-ctas">
        <StoreBadge store={site.store} lang={site.lang} />
        <a class="btn btn--ghost" href={h.secondary.href}>{h.secondary.label}</a>
      </div>
      <p class="hero-facts">{h.facts}</p>
    </div>
    <Callouts src={cockpit.ipad} alt={h.shot_alt} callouts={h.callouts} />
  </div>
</section>

<style>
  .hero { padding: 64px 0 32px; }
  .hero-copy { text-align: center; max-width: 760px; margin: 0 auto 44px; }
  .hero-title { font-size: clamp(38px, 6vw, 68px); margin: 14px 0 18px; }
  .hero-sub { font-size: 18.5px; line-height: 1.6; color: var(--muted); margin: 0 auto 26px; max-width: 46ch; }
  .hero-ctas { display: flex; gap: 14px; justify-content: center; align-items: center; flex-wrap: wrap; }
  .hero-facts { margin: 18px 0 0; font-family: var(--mono); font-size: 12.5px; letter-spacing: .04em; color: var(--dim); }
  @media (max-width: 640px) {
    .hero { padding-top: 40px; }
    .hero-sub { font-size: 17px; }
  }
</style>
