          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prépare l’étape suivante de ce voyage depuis %1$@, en rejoignant votre route vers %2$@. Météo et NOTAM sont de nouveau décochés : revoyez-les après ce déroutement."
