<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Privacy manifest (SEC-C41).

	  The app had none, despite using two required-reason API categories. This is an App Store
	  Connect compliance surface rather than a vulnerability — there is no attacker — but Apple's
	  enforcement has been tightening and a rejected submission is a real operational risk for a
	  solo maintainer.

	  Declared reasons are the narrow, accurate ones:
	    * CA92.1  — UserDefaults accessed only to read/write this app's own settings. No
	                third-party SDK, no cross-app identification.
	    * 1C8F.1  — UserDefaults of this app's own App Group, shared with our widget (the
	                owned-aircraft list and the widget launch token). Nothing read there leaves
	                the device. CA92.1 does not cover an App Group. (S9-32)
	    * C617.1  — file timestamps read only for files the app itself wrote (cache freshness,
	                sweeping orphaned CKAsset staging files).
	    * 85F4.1  — file size read only to enforce this app's own import size caps.

	  Data types match what actually leaves the device: precise location (flight tracks, synced to
	  the USER'S OWN iCloud via CloudKit and sent — coarsened — to a terrain provider when a profile
	  is generated), purchase history (subscription verification) and a user ID. Nothing is used for
	  tracking and no data broker is involved, so NSPrivacyTracking is false and the tracking-domain
	  list is empty.

	  Purchase history and the user ID are LINKED to the user (S9-33). The app sends the purchase's
	  Apple originalTransactionId as `userId`, and the API server keeps the entitlement record
	  under that key for as long as the purchase lasts (bounded, see the server's KV table) and
	  binds the purchase to it: an identifier for an account, not anonymous purchase telemetry.
	  The App Store Connect privacy label must say the same (User ID: linked, App Functionality,
	  not used for tracking).
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePreciseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePurchaseHistory</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
				<string>1C8F.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>85F4.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
