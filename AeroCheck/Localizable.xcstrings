    "planFlight.noAerodromesOnRoute": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Flugplatz innerhalb von 5 NM dieser Route. Um sie aufzuteilen, tippen Sie auf «Anderswo landen…»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No aerodrome within 5 NM of this route. To split it, tap Land somewhere else…"
          }
