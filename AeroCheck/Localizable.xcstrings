      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provided as is, without warranty of any kind. Use at your own risk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fourni en l'état, sans garantie d'aucune sorte. Utilisation à vos propres risques."
