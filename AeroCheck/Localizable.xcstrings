    "addStops.explainer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Zwischenhalt, den Sie abhaken, fügt eine Etappe hinzu: Der Flug wird zu einer Reise, jede Etappe mit eigener Flugbuchzeile, eigenem ATC-Flugplan, Nav-Log und Abschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each stop you tick adds a leg: the flight becomes a trip, each leg with its own logbook line, ATC flight plan, nav log and close-out."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque escale cochée ajoute une étape : le vol devient un voyage, chaque étape avec sa ligne de carnet de vol, son plan de vol ATC, son log de navigation et sa clôture."
          }
        }
      }
    },
    "addStops.localHint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Flugplätze innerhalb von %1$lld NM um %2$@, die nächsten zuerst. Haken Sie sie in der Reihenfolge ab, in der Sie dort landen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aerodromes within %1$lld NM of %2$@, nearest first. Tick them in the order you will land there."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aérodromes à moins de %1$lld NM de %2$@, les plus proches d’abord. Cochez-les dans l’ordre où vous y atterrirez."
          }
        }
      }
    },
