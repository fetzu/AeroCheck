---
import type { FlagshipItem } from '../lib/site';
import { shot } from '../lib/shots';
import DevicePair from './DevicePair.astro';
interface Props { item: FlagshipItem; index: number; labels: { ipad: string; iphone: string }; }
const { item, index, labels } = Astro.props;
const s = shot(item.shot);
const phone = item.iphone_shot ? shot(item.iphone_shot) : s;
const reverse = index % 2 === 1;
---
<div id={item.anchor} class:list={['feature-row', 'reveal', { 'feature-row--reverse': reverse, 'feature-row--fly': item.fly }]}>
  <div class="feature-copy">
    <p class="step">{item.step}</p>
    <h3 class="feature-title">{item.title}</h3>
    <p class="feature-desc">{item.description}</p>
    <div class="chips">{item.chips.map((c) => <span class="chip">{c}</span>)}</div>
  </div>
  <div class="feature-media">
    <DevicePair ipad={[s.ipad]} iphone={[phone.iphone]} alts={[item.title]} labels={labels} />
  </div>
</div>

<style>
  .feature-row { scroll-margin-top: 84px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; padding: 40px 0; border-bottom: 1px solid var(--line); }
  .feature-row--reverse .feature-copy { order: 2; }
  .step { font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--gold); margin: 0 0 10px; }
  .feature-row--fly .step { color: var(--cyan); }
  .feature-row--fly .chips :global(.chip) { border-color: rgba(61, 199, 237, .35); }
  .feature-title { font-size: 24px; margin-bottom: 12px; }
  .feature-desc { color: var(--muted); font-size: 15px; line-height: 1.7; margin: 0 0 16px; }
  .feature-media { max-width: 460px; width: 100%; margin: 0 auto; }
  @media (max-width: 820px) {
    .feature-row { grid-template-columns: 1fr; gap: 24px; }
    .feature-row--reverse .feature-copy { order: 0; }
  }
</style>
