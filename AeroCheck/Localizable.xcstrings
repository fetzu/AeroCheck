          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre carnet"
          }
        }
      }
    },
    "dryRunCoach.partDone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: done"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : fait"
          }
        }
      }
    },
    "dryRunCoach.partOf": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part %1$lld of %2$lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partie %1$lld sur %2$lld"
          }
        }
      }
    },
    "dryRunCoach.partsFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts the dry run at one part. Getting there takes a few seconds, with the earlier steps done for you."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence le vol à blanc à une partie. Y arriver prend quelques secondes, les étapes précédentes faites pour vous."
          }
        }
      }
    },
    "dryRunCoach.partsRow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One part at a time"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie à la fois"
          }
        }
      }
    },
    "dryRunCoach.step.afterStart.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work through it, then tap NEXT. The aircraft starts taxiing once you reach the taxi check."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites-la, puis touchez SUIVANT. L'avion commence à rouler quand vous arrivez à la vérification de roulage."
          }
        }
      }
    },
    "dryRunCoach.step.afterStart.fold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work through the after start check, then tap NEXT."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites la vérification après mise en marche, puis touchez SUIVANT."
          }
        }
      }
    },
    "dryRunCoach.step.afterStart.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The after start check"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification après mise en marche"
          }
        }
      }
    },
    "dryRunCoach.step.airborne.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app detected the take-off and recorded its time. In flight it follows along: you only tap when it asks you to."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app a détecté le décollage et enregistré son heure. En vol, elle suit : vous ne touchez que lorsqu'elle vous le demande."
          }
        }
      }
    },
    "dryRunCoach.step.airborne.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take-off detected"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décollage détecté"
          }
        }
      }
    },
    "dryRunCoach.step.approachAgain.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a circuit, it comes on the downwind, once you have turned onto it. Tap its button and work through it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En tour de piste, elle vient en vent arrière, une fois le virage terminé. Touchez son bouton et faites-la."
          }
        }
      }
    },
    "dryRunCoach.step.approachAgain.fold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work through the approach check again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Refaites la vérification d'approche."
          }
        }
      }
    },
    "dryRunCoach.step.approachAgain.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The approach check, again"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification d'approche, à nouveau"
          }
        }
      }
    },
    "dryRunCoach.step.approachAgain.upcoming": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the approach check, on the downwind"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "la vérification d'approche, en vent arrière"
          }
        }
      }
    },
    "dryRunCoach.step.approachCheck.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are about to join the circuit: the approach check comes before the downwind. Tap its button and work through it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous allez rejoindre le tour de piste : la vérification d'approche vient avant le vent arrière. Touchez son bouton et faites-la."
          }
        }
      }
    },
    "dryRunCoach.step.approachCheck.fold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work through the approach check."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites la vérification d'approche."
          }
        }
      }
    },
    "dryRunCoach.step.approachCheck.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to land"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le retour"
          }
        }
      }
    },
    "dryRunCoach.step.approachCheck.upcoming": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the approach check, before the downwind"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "la vérification d'approche, avant le vent arrière"
          }
        }
      }
    },
    "dryRunCoach.step.checkOnce.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CHECK ticks off the highlighted item and moves to the next one. Tap it once."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "COCHER valide l'élément en surbrillance et passe au suivant. Touchez-le une fois."
          }
        }
      }
    },
    "dryRunCoach.step.checkOnce.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check an item"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochez un élément"
          }
        }
      }
    },
    "dryRunCoach.step.climbAgain.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a go-around near your destination, the app continues as a circuit: the climb check again, then the approach check on the downwind, with no cruise or descent check. Work through the climb check on the way round."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après une remise de gaz près de votre destination, l'app continue en tour de piste : la vérification de montée à nouveau, puis celle d'approche en vent arrière, sans croisière ni descente. Faites la vérification de montée pendant le tour."
          }
        }
      }
    },
    "dryRunCoach.step.climbAgain.fold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work through the climb check again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Refaites la vérification de montée."
          }
        }
      }
    },
    "dryRunCoach.step.climbAgain.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Around again"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tour de plus"
          }
        }
      }
    },
    "dryRunCoach.step.climbAgain.upcoming": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the climb check again, once climbing"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "la vérification de montée à nouveau, une fois en montée"
          }
        }
      }
    },
    "dryRunCoach.step.climbCheck.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you are established in a positive, trimmed climb (usually 400 to 500 ft above the ground), tap its button and work through it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois établi en montée positive et compensée (en général à 400 ou 500 ft sol), touchez son bouton et faites-la."
          }
        }
      }
    },
    "dryRunCoach.step.climbCheck.fold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work through the climb check."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites la vérification de montée."
          }
        }
      }
    },
    "dryRunCoach.step.climbCheck.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The climb check"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification de montée"
          }
        }
      }
    },
    "dryRunCoach.step.climbCheck.upcoming": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the climb check, once established in the climb"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "la vérification de montée, une fois établi en montée"
          }
        }
      }
    },
    "dryRunCoach.step.closeOut.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "END FLIGHT moved the flight to CLOSE-OUT, where you find what is left to close. If you had filed a flight plan, closing it would come first, in red, with the number to call."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TERMINER LE VOL a mis le vol en CLÔTURE, où vous trouvez ce qui reste à clore. Avec un plan de vol déposé, sa clôture viendrait en premier, en rouge, avec le numéro à appeler."
          }
        }
      }
    },
    "dryRunCoach.step.closeOut.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the flight"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après le vol"
          }
        }
      }
    },
    "dryRunCoach.step.cockpit.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the Cockpit you fly with. In a real flight, you open it with START FLIGHT on Today; here the dry run opened it for you. The aircraft waits for you at each step."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici le cockpit avec lequel vous volez. En vrai vol, vous l'ouvrez avec DÉMARRER LE VOL sur Aujourd'hui ; ici, le vol à blanc l'a ouvert pour vous. L'avion vous attend à chaque étape."
          }
        }
      }
    },
    "dryRunCoach.step.cockpit.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first flight, on the ground"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre premier vol, au sol"
          }
        }
      }
    },
    "dryRunCoach.step.cockpitAfterPlan.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the Cockpit, opened by START FLIGHT. The aircraft waits for you at each step."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici le cockpit, ouvert par DÉMARRER LE VOL. L'avion vous attend à chaque étape."
          }
        }
      }
    },
    "dryRunCoach.step.cockpitAfterPlan.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your first flight, on the ground"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre premier vol, au sol"
          }
        }
      }
    },
    "dryRunCoach.step.cruiseCheck.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are level at the cruise, so the cruise check is due. Tap its button and work through it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes en palier de croisière : la vérification de croisière est due. Touchez son bouton et faites-la."
          }
        }
      }
    },
    "dryRunCoach.step.cruiseCheck.fold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work through the cruise check."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites la vérification de croisière."
          }
        }
      }
    },
    "dryRunCoach.step.cruiseCheck.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cruise check"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification de croisière"
          }
        }
      }
    },
    "dryRunCoach.step.cruiseCheck.upcoming": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the cruise check, at the level-off"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "la vérification de croisière, à la mise en palier"
          }
        }
      }
    },
    "dryRunCoach.step.dashboard.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your hours, flights and landings, the hours per aircraft, what you spent and how your checks went. The dry run's logbook has five made-up flights before yours."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos heures, vols et atterrissages, les heures par avion, ce que vous avez dépensé et comment vos vérifications se sont passées. Le carnet du vol à blanc a cinq vols inventés avant le vôtre."
          }
        }
      }
    },
    "dryRunCoach.step.dashboard.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The year at a glance"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'année en un coup d'œil"
          }
        }
      }
    },
    "dryRunCoach.step.debrief.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you like, write down what went well and what to change. It's optional, and it becomes the flight's notes in your logbook."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous le souhaitez, notez ce qui s'est bien passé et ce qu'il faut changer. C'est facultatif, et cela devient les notes du vol dans votre carnet."
          }
        }
      }
    },
    "dryRunCoach.step.debrief.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Debrief"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débriefing"
          }
        }
      }
    },
    "dryRunCoach.step.defer.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't do an item right now? DEFER puts it aside, and the app keeps it for later. Try it now."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un élément impossible à faire maintenant ? REPORTER le met de côté, et l'app le garde pour plus tard. Essayez maintenant."
          }
        }
      }
    },
    "dryRunCoach.step.defer.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Defer an item"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reporter un élément"
          }
        }
      }
    },
    "dryRunCoach.step.deferredChip.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you deferred waits here, in amber. Tap it at any time to finish it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que vous avez reporté attend ici, en ambre. Touchez-le à tout moment pour le terminer."
          }
        }
      }
    },
    "dryRunCoach.step.deferredChip.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is lost"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne se perd"
          }
        }
      }
    },
    "dryRunCoach.step.descentCheck.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The descent has started, so the descent check is due. Tap its button and work through it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La descente a commencé : la vérification de descente est due. Touchez son bouton et faites-la."
          }
        }
      }
    },
    "dryRunCoach.step.descentCheck.fold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work through the descent check."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites la vérification de descente."
          }
        }
      }
    },
    "dryRunCoach.step.descentCheck.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The descent check"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification de descente"
          }
        }
      }
    },
    "dryRunCoach.step.descentCheck.upcoming": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the descent check, as the descent begins"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "la vérification de descente, au début de la descente"
          }
        }
      }
    },
    "dryRunCoach.step.endFlight.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It closes the flight and creates its logbook entry, with the times from the GPS track. This is a dry run, so none of it is kept."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il clôt le vol et crée son entrée de carnet, avec les heures de la trace GPS. C'est un vol à blanc : rien n'en est gardé."
          }
        }
      }
    },
    "dryRunCoach.step.endFlight.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "END FLIGHT"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TERMINER LE VOL"
          }
        }
      }
    },
    "dryRunCoach.step.engineShutdown.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine has stopped: tap it, and the app records the time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur est arrêté : touchez-le, et l'app enregistre l'heure."
          }
        }
      }
    },
    "dryRunCoach.step.engineShutdown.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ENGINE SHUTDOWN"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ARRÊT MOTEUR"
          }
        }
      }
    },
    "dryRunCoach.step.engineShutdown.upcoming": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ENGINE SHUTDOWN, once parked"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ARRÊT MOTEUR, une fois au parking"
          }
        }
      }
    },
    "dryRunCoach.step.engineStart.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap it once the engine is running: the app records the time, and the flight times start from there."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez-le une fois le moteur en marche : l'app enregistre l'heure, et les temps du vol partent de là."
          }
        }
      }
    },
    "dryRunCoach.step.engineStart.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ENGINE START"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MISE EN MARCHE"
          }
        }
      }
    },
    "dryRunCoach.step.engineStartCheck.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its items come before the start. Work through them, then press ENGINE START."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses éléments viennent avant la mise en marche. Faites-les, puis appuyez sur MISE EN MARCHE."
          }
        }
      }
    },
    "dryRunCoach.step.engineStartCheck.fold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work through the engine start check, then press ENGINE START."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites la vérification de mise en marche, puis appuyez sur MISE EN MARCHE."
          }
        }
      }
    },
    "dryRunCoach.step.engineStartCheck.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine start check"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification de mise en marche"
          }
        }
      }
    },
    "dryRunCoach.step.exports.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export creates a GPX or JSON file of the flight; Export in the logbook creates the EASA logbook PDF. To plan the same flight again, swipe right on it in the logbook."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporter crée un fichier GPX ou JSON du vol ; Exporter dans le carnet crée le PDF du carnet de vol EASA. Pour planifier à nouveau le même vol, balayez-le vers la droite dans le carnet."
          }
        }
      }
    },
    "dryRunCoach.step.exports.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export, and plan again"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporter, et replanifier"
          }
        }
      }
    },
    "dryRunCoach.step.finish.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish closes the flight's page; the flight stays in your logbook."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminer ferme la page du vol ; le vol reste dans votre carnet."
          }
        }
      }
    },
    "dryRunCoach.step.finish.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminer"
          }
        }
      }
    },
    "dryRunCoach.step.flightPage.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each flight has its own page, from the plan to the logbook: the flight thread. Its four chapters (Plan, Prepare, Fly and Close) follow the stages of every flight, and a tap on one takes you there. The circle at the top shows how much is done."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque vol a sa page, du plan au carnet : le fil du vol. Ses quatre chapitres (Planifier, Préparer, Voler et Clôturer) suivent les étapes de chaque vol, et un appui sur l'un d'eux vous y mène. Le cercle en haut montre ce qui est fait."
          }
        }
      }
    },
    "dryRunCoach.step.flightPage.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One page per flight"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une page par vol"
          }
        }
      }
    },
    "dryRunCoach.step.fuelDone.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Done, at the top right, to keep this fuel on board for the flight and close the sheet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Terminé, en haut à droite, pour garder ce carburant à bord pour le vol et fermer la feuille."
          }
        }
      }
    },
    "dryRunCoach.step.fuelDone.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save it"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer"
          }
        }
      }
    },
    "dryRunCoach.step.fuelRow.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AUTO rows are filled in automatically from the route and the aircraft. Tap the fuel plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lignes AUTO se remplissent automatiquement à partir de la route et de l'avion. Touchez le plan carburant."
          }
        }
      }
    },
    "dryRunCoach.step.fuelRow.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Worked out automatically"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculé automatiquement"
          }
        }
      }
    },
    "dryRunCoach.step.fuelSheet.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This shows what the route needs and what you have on board. Tap Full tanks. If no full-tanks figure is known for this aircraft yet, type the usable fuel from the POH (any figure will do in a dry run), then tap Save · full tanks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous voyez ce que la route demande et ce que vous avez à bord. Touchez Pleins. Si aucun chiffre n'est encore connu pour cet avion, saisissez le carburant utilisable selon le manuel de vol (n'importe lequel en vol à blanc), puis touchez Enregistrer · pleins."
          }
        }
      }
    },
    "dryRunCoach.step.fuelSheet.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuel on board"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Carburant à bord"
          }
        }
      }
    },
    "dryRunCoach.step.fullStop.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FULL STOP is already selected, so the aircraft lands. On short final, tap the landing check and work through its items."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "COMPLET est déjà choisi : l'avion se pose. En courte finale, touchez la vérification d'atterrissage et faites ses éléments."
          }
        }
      }
    },
    "dryRunCoach.step.fullStop.fold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On short final, work through the landing check."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En courte finale, faites la vérification d'atterrissage."
          }
        }
      }
    },
    "dryRunCoach.step.fullStop.memoryBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FULL STOP is already selected, so the aircraft lands. On short final, say the landing check from memory, then tap it once to record it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "COMPLET est déjà choisi : l'avion se pose. En courte finale, récitez la vérification d'atterrissage de mémoire, puis touchez-la une fois pour l'enregistrer."
          }
        }
      }
    },
    "dryRunCoach.step.fullStop.memoryFold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On short final, tap the landing check once."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En courte finale, touchez une fois la vérification d'atterrissage."
          }
        }
      }
    },
    "dryRunCoach.step.fullStop.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This time, a full stop"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette fois, un atterrissage complet"
          }
        }
      }
    },
    "dryRunCoach.step.goAround.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this final, choose GO AROUND on the card: the aircraft climbs away and the app detects the go-around. In a real flight, you fly it yourself."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur cette finale, choisissez REMISE DE GAZ dans l'encadré : l'avion remonte et l'app détecte la remise de gaz. En vrai vol, c'est vous qui remettez les gaz."
          }
        }
      }
    },
    "dryRunCoach.step.goAround.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a go-around"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez une remise de gaz"
          }
        }
      }
    },
    "dryRunCoach.step.goAround.upcoming": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "a go-around, on the final"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "une remise de gaz, en finale"
          }
        }
      }
    },
    "dryRunCoach.step.goAroundCard.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app detected the go-around and recorded it automatically: the checks went back to the climb check. If it wasn't one, Undo takes it back for a few seconds. After a real flight, you confirm it in the Flight review."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app a détecté la remise de gaz et l'a enregistrée automatiquement : les vérifications sont revenues à celle de montée. Si ce n'en était pas une, Annuler revient en arrière pendant quelques secondes. Après un vrai vol, vous la confirmez dans la Revue du vol."
          }
        }
      }
    },
    "dryRunCoach.step.goAroundCard.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go-around detected"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remise de gaz détectée"
          }
        }
      }
    },
    "dryRunCoach.step.hoursAfter.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the hour meter reading again. From the two readings, the logbook and the cost work out the time flown."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez à nouveau la lecture de l'horamètre. Avec les deux lectures, le carnet de vol et le coût calculent le temps de vol."
          }
        }
      }
    },
    "dryRunCoach.step.hoursAfter.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Engine hours"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heures moteur"
          }
        }
      }
    },
    "dryRunCoach.step.hoursBefore.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before starting the engine, enter the hour meter reading. The logbook and the cost use it to work out the time flown. In a dry run any number will do, or tap Skip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant la mise en marche, saisissez la lecture de l'horamètre. Le carnet de vol et le coût s'en servent pour calculer le temps de vol. En vol à blanc, n'importe quel nombre convient, ou touchez Passer."
          }
        }
      }
    },
    "dryRunCoach.step.hoursBefore.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Engine hours"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heures moteur"
          }
        }
      }
    },
    "dryRunCoach.step.landingShown.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On short final comes the landing check. It appears here, dashed: tap it to open it, then work through its items."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En courte finale vient la vérification d'atterrissage. Elle apparaît ici en pointillé : touchez-la pour l'ouvrir, puis faites ses éléments."
          }
        }
      }
    },
    "dryRunCoach.step.landingShown.memoryBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On short final comes the landing check, said from memory. It appears here, dashed, with nothing to press."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En courte finale vient la vérification d'atterrissage, à réciter de mémoire. Elle apparaît ici en pointillé, sans rien à toucher."
          }
        }
      }
    },
    "dryRunCoach.step.landingShown.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The landing check"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification d'atterrissage"
          }
        }
      }
    },
    "dryRunCoach.step.legControls.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MARK records the time over the next waypoint when you tap it, and the leg timer under it starts again. You don't have to: the app marks each waypoint automatically when you pass abeam of it, within 2.5 NM of the route. Mark it yourself for a waypoint passed further away (a detour, a clearance), or to note the exact time you report it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MARQUER enregistre l'heure de passage du prochain point quand vous le touchez, et le chrono de branche en dessous repart. Ce n'est pas obligatoire : l'app marque automatiquement chaque point quand vous passez par son travers, à 2,5 NM de la route au plus. Marquez-le vous-même pour un point passé plus loin (un détour, une clairance), ou pour noter l'heure exacte où vous l'annoncez."
          }
        }
      }
    },
    "dryRunCoach.step.radioDue.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changed frequency? Tap NEXT"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changé de fréquence ? Touchez SUIV"
          }
        }
      }
    },
    "dryRunCoach.step.radioDue.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NEXT is outlined: it is time to change to it, and the line along its foot runs out where the app changes by itself. When you change frequency, tap NEXT (on a phone, the NOW line) and it becomes NOW. Undo takes it back."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SUIV est encadré : c'est le moment d'y passer, et la ligne à son pied s'épuise jusqu'à l'endroit où l'app change d'elle-même. Quand vous changez de fréquence, touchez SUIV (sur un téléphone, la ligne ACT) et il devient ACT. Annuler revient en arrière."
          }
        }
      }
    },
    "dryRunCoach.step.radioDue.fold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap NEXT when you change frequency."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez SUIV en changeant de fréquence."
          }
        }
      }
    },
    "dryRunCoach.step.legControls.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MARK and the leg timer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MARQUER et le chrono de branche"
          }
        }
      }
    },
    "dryRunCoach.step.lineUpCheck.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work through it. The aircraft lines up once you have finished."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites-la. L'avion s'aligne une fois que vous avez terminé."
          }
        }
      }
    },
    "dryRunCoach.step.lineUpCheck.fold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work through the line-up check."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites la vérification d'alignement."
          }
        }
      }
    },
    "dryRunCoach.step.lineUpCheck.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The line-up check"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification d'alignement"
          }
        }
      }
    },
    "dryRunCoach.step.link.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gold buttons stay in the app; blue ones open a website. Tap Open NOTAM briefing: in a dry run, the app only tells you where it would go."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les boutons dorés restent dans l'app ; les bleus ouvrent un site. Touchez Ouvrir le briefing NOTAM : en vol à blanc, l'app indique seulement où il mènerait."
          }
        }
      }
    },
    "dryRunCoach.step.link.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gold or blue"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Or ou bleu"
          }
        }
      }
    },
    "dryRunCoach.step.logbookLine.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Logbook line: it shows the line for your logbook, with its times taken from the GPS track."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Ligne de carnet de vol : elle montre la ligne pour votre carnet, avec ses heures tirées de la trace GPS."
          }
        }
      }
    },
    "dryRunCoach.step.logbookLine.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The logbook line"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ligne du carnet"
          }
        }
      }
    },
    "dryRunCoach.step.logbookTab.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Logbook, in the tab bar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Carnet de vol, dans la barre d'onglets."
          }
        }
      }
    },
    "dryRunCoach.step.logbookTab.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your logbook"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre carnet"
          }
        }
      }
    },
    "dryRunCoach.step.mapAgain.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That was the last turning point. Open MAP again to see the way home and the circuit ahead."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'était le dernier point de virage. Rouvrez CARTE pour voir le retour et le tour de piste devant vous."
          }
        }
      }
    },
    "dryRunCoach.step.mapAgain.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to the map"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retour à la carte"
          }
        }
      }
    },
    "dryRunCoach.step.mapTakeoff.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open MAP. In a dry run, the aircraft lines up and takes off automatically; your next step is the climb check, once airborne."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez CARTE. En vol à blanc, l'avion s'aligne et décolle automatiquement ; votre prochaine étape est la vérification de montée, une fois en l'air."
          }
        }
      }
    },
    "dryRunCoach.step.mapTakeoff.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch the take-off"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez le décollage"
          }
        }
      }
    },
    "dryRunCoach.step.memorySwitch.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When it is on, the checks only show the items to read; you say the others from memory and confirm them with one tap. Turn it on once you know them, then close the Menu to continue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé, les vérifications n'affichent que les éléments à lire ; vous récitez les autres de mémoire et les confirmez d'un appui. Activez-le quand vous les connaissez, puis fermez le Menu pour continuer."
          }
        }
      }
    },
    "dryRunCoach.step.memorySwitch.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide memory items"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer les éléments mémoire"
          }
        }
      }
    },
    "dryRunCoach.step.memoryTest.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine start check has items you read and items you should know by heart: its memory items. The Menu can hide them, so you practise saying them from memory. Open the Menu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification de mise en marche contient des éléments à lire et des éléments à connaître par cœur : ses éléments mémoire. Le Menu peut les masquer, pour que vous les récitiez de mémoire. Ouvrez le Menu."
          }
        }
      }
    },
    "dryRunCoach.step.memoryTest.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory items"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments mémoire"
          }
        }
      }
    },
    "dryRunCoach.step.nextCard.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What to do next is always at the top of the page, and on Today."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prochaine chose à faire est toujours en haut de la page, et sur Aujourd'hui."
          }
        }
      }
    },
    "dryRunCoach.step.nextCard.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next thing"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prochaine chose"
          }
        }
      }
    },
    "dryRunCoach.step.notApplicable.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A local flight doesn't need a flight plan: long-press Flight plan filed, then choose Not applicable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vol local n'a pas besoin de plan de vol : touchez longuement Plan de vol ATC déposé, puis choisissez Non applicable."
          }
        }
      }
    },
    "dryRunCoach.step.notApplicable.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not for this flight"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas pour ce vol"
          }
        }
      }
    },
    "dryRunCoach.step.numbers.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Block and flight time, the landings, the engine hours, and the cost at the aircraft's rate. Copy line puts the line on the clipboard. Close the sheet when you have read it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temps bloc et temps de vol, les atterrissages, les heures moteur, et le coût au tarif de l'avion. Copier la ligne la met dans le presse-papiers. Fermez la feuille quand vous l'avez lue."
          }
        }
      }
    },
    "dryRunCoach.step.numbers.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logbook & costs"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Carnet et coûts"
          }
        }
      }
    },
    "dryRunCoach.step.openFlightPage.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Today, tap the flight: its page is now in CLOSE-OUT."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur Aujourd'hui, touchez le vol : sa page est maintenant en CLÔTURE."
          }
        }
      }
    },
    "dryRunCoach.step.openFlightPage.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to the flight"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retour au vol"
          }
        }
      }
    },
    "dryRunCoach.step.openLoggedFlight.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the flight you just flew."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le vol que vous venez de faire."
          }
        }
      }
    },
    "dryRunCoach.step.openLoggedFlight.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your flight"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre vol"
          }
        }
      }
    },
    "dryRunCoach.step.planSheet.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here you choose the departure, the destination, any stops, the day and the aircraft. For this dry run the route is ready: your aerodrome, two turning points and back. A flight planned for another day gets a reminder the day before. Tap Create flight."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ici, vous choisissez le départ, la destination, les escales, le jour et l'avion. Pour ce vol à blanc, la route est prête : votre aérodrome, deux points de virage et retour. Un vol prévu un autre jour reçoit un rappel la veille. Touchez Créer le vol."
          }
        }
      }
    },
    "dryRunCoach.step.planSheet.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The flight"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le vol"
          }
        }
      }
    },
    "dryRunCoach.step.readBand.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GS, ALT and TRK come from the GPS. Below them, you find where the current leg leads and when you get there, then who to call: NOW and NEXT."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GS, ALT et TRK viennent du GPS. En dessous, vous trouvez où mène la branche en cours et quand vous y serez, puis qui appeler : ACT et SUIV."
          }
        }
      }
    },
    "dryRunCoach.step.readBand.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you read"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous lisez"
          }
        }
      }
    },
    "dryRunCoach.step.readyForLineUp.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap it. The app uses this moment as the take-off time and times the route from it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez-le. L'app prend ce moment comme heure de décollage et chronomètre la route à partir de là."
          }
        }
      }
    },
    "dryRunCoach.step.readyForLineUp.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "READY FOR LINE UP"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PRÊT POUR L'ALIGNEMENT"
          }
        }
      }
    },
    "dryRunCoach.step.routePage.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open ROUTE: it lists the legs with their times, and every frequency in the order you will use them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez ROUTE : la liste des branches avec leurs heures, et chaque fréquence dans l'ordre où vous l'utiliserez."
          }
        }
      }
    },
    "dryRunCoach.step.routePage.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The route"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La route"
          }
        }
      }
    },
    "dryRunCoach.step.shutdownCheck.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work through the engine shutdown check. When the engine stops (magnetos or ignition off), press ENGINE SHUTDOWN, then finish the check."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites la vérification d'arrêt moteur. Quand le moteur s'arrête (magnétos ou allumage sur OFF), appuyez sur ARRÊT MOTEUR, puis terminez la vérification."
          }
        }
      }
    },
    "dryRunCoach.step.shutdownCheck.fold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work through the engine shutdown check up to the magnetos, then press ENGINE SHUTDOWN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites la vérification d'arrêt moteur jusqu'aux magnétos, puis appuyez sur ARRÊT MOTEUR."
          }
        }
      }
    },
    "dryRunCoach.step.shutdownCheck.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the parking"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au parking"
          }
        }
      }
    },
    "dryRunCoach.step.startFlight.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "START FLIGHT, in the Fly chapter, opens the Cockpit. For this dry run, the rest of Plan and Prepare has been ticked for you. In a real flight, START FLIGHT first lists anything still open."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DÉMARRER LE VOL, dans le chapitre Voler, ouvre le cockpit. Pour ce vol à blanc, le reste de Planifier et Préparer a été coché pour vous. En vrai vol, DÉMARRER LE VOL liste d'abord ce qui reste ouvert."
          }
        }
      }
    },
    "dryRunCoach.step.startFlight.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "START FLIGHT"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DÉMARRER LE VOL"
          }
        }
      }
    },
    "dryRunCoach.step.tickLogbook.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you have copied the line into your logbook, tick its row: the close-out is complete."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois la ligne reportée dans votre carnet, cochez sa ligne : la clôture est terminée."
          }
        }
      }
    },
    "dryRunCoach.step.tickLogbook.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Into your logbook"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans votre carnet"
          }
        }
      }
    },
    "dryRunCoach.step.tickNotam.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once the NOTAMs are read, tick their row."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois les NOTAM lus, cochez leur ligne."
          }
        }
      }
    },
    "dryRunCoach.step.tickNotam.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tick it"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochez-la"
          }
        }
      }
    },
    "dryRunCoach.step.timeOver.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app detected the passage of this turning point: it recorded the time over on ROUTE and moved to the next leg automatically. If that was too early, Undo here takes it back."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app a détecté le passage de ce point de virage : elle a noté l'heure de passage sur ROUTE et est passée automatiquement à la branche suivante. Si c'était trop tôt, Annuler ici revient en arrière."
          }
        }
      }
    },
    "dryRunCoach.step.timeOver.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The turning point"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le point de virage"
          }
        }
      }
    },
    "dryRunCoach.step.toAfterStart.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap NEXT to open the after start check."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez SUIVANT pour ouvrir la vérification après mise en marche."
          }
        }
      }
    },
    "dryRunCoach.step.toAfterStart.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the start"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après la mise en marche"
          }
        }
      }
    },
    "dryRunCoach.step.toBeforeDeparture.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The aircraft waits here. Work through the checks up to the before take-off check; when it is complete, press READY FOR LINE UP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'avion attend ici. Faites les vérifications jusqu'à celle avant le départ ; une fois terminée, appuyez sur PRÊT POUR L'ALIGNEMENT."
          }
        }
      }
    },
    "dryRunCoach.step.toBeforeDeparture.fold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep working through the checks up to READY FOR LINE UP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez les vérifications jusqu'à PRÊT POUR L'ALIGNEMENT."
          }
        }
      }
    },
    "dryRunCoach.step.toBeforeDeparture.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the holding point"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au point d'attente"
          }
        }
      }
    },
    "dryRunCoach.step.toBeforeDeparture.upcoming": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the checks up to the before take-off check, at the holding point"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "les vérifications jusqu'à celle avant le départ, au point d'attente"
          }
        }
      }
    },
    "dryRunCoach.step.toEndFlight.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish the engine shutdown check and the last checks, then press END FLIGHT."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez la vérification d'arrêt moteur et les dernières vérifications, puis appuyez sur TERMINER LE VOL."
          }
        }
      }
    },
    "dryRunCoach.step.toEndFlight.fold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish the last checks, then END FLIGHT."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez les dernières vérifications, puis TERMINER LE VOL."
          }
        }
      }
    },
    "dryRunCoach.step.toEndFlight.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last checks"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dernières vérifications"
          }
        }
      }
    },
    "dryRunCoach.step.toEngineStart.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap CHECK for each item. When a check is complete, NEXT opens the following one. Work through the checks up to the engine start check."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez COCHER pour chaque élément. Quand une vérification est terminée, SUIVANT ouvre la suivante. Faites les vérifications jusqu'à celle de mise en marche."
          }
        }
      }
    },
    "dryRunCoach.step.toEngineStart.fold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep working through the checks up to the engine start check."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez les vérifications jusqu'à celle de mise en marche."
          }
        }
      }
    },
    "dryRunCoach.step.toEngineStart.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work through the checks"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire les vérifications"
          }
        }
      }
    },
    "dryRunCoach.step.toShutdown.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app detected the full stop and opened the after landing check automatically. Work through it while the aircraft taxis in; when it is complete, PARKING CHECK moves on to the engine shutdown."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app a détecté l'atterrissage complet et ouvert automatiquement la vérification après l'atterrissage. Faites-la pendant que l'avion roule ; une fois terminée, ARRÊT MOTEUR mène à l'arrêt du moteur."
          }
        }
      }
    },
    "dryRunCoach.step.toShutdown.fold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work through the after landing check, then PARKING CHECK."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites la vérification après l'atterrissage, puis ARRÊT MOTEUR."
          }
        }
      }
    },
    "dryRunCoach.step.toShutdown.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To the parking"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vers le parking"
          }
        }
      }
    },
    "dryRunCoach.step.today.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every flight starts on Today. Tap Plan new flight."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque vol commence sur Aujourd'hui. Touchez Planifier un vol."
          }
        }
      }
    },
    "dryRunCoach.step.today.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan a flight"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparez un vol"
          }
        }
      }
    },
    "dryRunCoach.step.track.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything about this flight is here: its track on the map, the altitude and speed chart (slide along it to replay the flight), the timeline, how each check ended, the engine hours and the plan compared with what you flew. Have a look around, then tap Next."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce vol est ici : sa trace sur la carte, le graphique d'altitude et de vitesse (glissez dessus pour rejouer le vol), la chronologie, comment chaque vérification s'est terminée, les heures moteur et le plan comparé au vol. Regardez à votre guise, puis touchez Suivant."
          }
        }
      }
    },
    "dryRunCoach.step.track.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The flight's page"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page du vol"
          }
        }
      }
    },
